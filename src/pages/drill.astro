---
import Base from '../layouts/Base.astro';

const exercises = [
  {
    id: 'air',
    heading: '공습경보를 받았다면?',
    context: '집 근처에 폭발 위험이 있고, 현재 위치의 안전을 확신할 수 없습니다.',
    choices: [
      { label: '멀리 운전해 다른 도시로 이동한다', correct: false },
      { label: '가까운 안전한 대피시설 또는 튼튼한 건물 안쪽으로 피한다', correct: true },
      { label: '지도 검색을 끝낼 때까지 창가에서 기다린다', correct: false },
    ],
    explanation: '가까운 안전한 곳으로 먼저 피하세요. 현장 위험이 임박했다면 대피소를 검색하느라 피신을 늦추지 않습니다. 침수된 지하공간은 피하고 공식 지시를 따르세요.',
    href: '/situations/#air-raid',
  },
  {
    id: 'chemical',
    heading: '외부 화학물질 오염 경보가 왔다면?',
    context: '재난문자에 외부 오염 우려가 안내됐으며, 건물 안쪽은 오염되지 않은 상태입니다.',
    choices: [
      { label: '모든 창문을 열어 환기한다', correct: false },
      { label: '경보 지시를 확인하고 문·창문을 닫아 외부 공기 유입을 막는다', correct: true },
      { label: '상황과 관계없이 지하주차장으로 내려간다', correct: false },
    ],
    explanation: '경보 대상 지역과 실내 대기·이동 지시를 먼저 확인하세요. 안전한 실내에 있을 때는 외부 공기 유입을 줄이되, 건물 안에서 누출됐다면 오염 공간에서 벗어나야 합니다.',
    href: '/situations/#chemical',
  },
  {
    id: 'earthquake',
    heading: '지진으로 바닥이 흔들린다면?',
    context: '건물 안에 있고 흔들림이 아직 멈추지 않았습니다.',
    choices: [
      { label: '먼저 머리와 몸을 보호한다', correct: true },
      { label: '흔들리는 동안 엘리베이터를 탄다', correct: false },
      { label: '곧바로 창가에서 밖을 내려다본다', correct: false },
    ],
    explanation: '흔들리는 동안 튼튼한 탁자 아래 등에서 머리와 몸을 보호하세요. 흔들림이 멈춘 뒤 주변 낙하물과 건물 상태를 살피고 공식 안내를 확인합니다.',
    href: '/situations/#earthquake',
  },
] as const;
---
<Base title="평소 3분 재난 행동 연습" description="공습·화학·지진 상황에서 첫 행동을 선택해 보는 간단한 사전 훈련입니다. 실제 상황에서는 공식 재난 경보와 현장 지시를 따르세요.">
  <div class="container drill-page">
    <header class="page-intro">
      <span class="eyebrow">평상시 연습 전용</span>
      <h1>재난 행동, 평소에 3분만 연습하세요</h1>
      <p>짧은 상황을 읽고 첫 행동을 선택해 보세요. 답을 고르면 이유가 바로 나옵니다.</p>
    </header>
    <p class="drill-alert"><strong>실제 위험한 상황인가요?</strong> 지금은 훈련할 때가 아닙니다. <a href="/emergency/">긴급 행동요령</a>과 재난문자·방송·현장 지시를 먼저 확인하세요. 이 연습은 개인의 안전을 진단하거나 보장하지 않습니다.</p>
    <div class="drill-grid">
      {exercises.map((exercise, index) => <section class="drill-card" aria-labelledby={'drill-title-' + exercise.id} data-explanation={exercise.explanation}>
        <span class="drill-index">연습 {index + 1} / {exercises.length}</span>
        <h2 id={'drill-title-' + exercise.id}>{exercise.heading}</h2>
        <p class="drill-context">{exercise.context}</p>
        <div class="drill-options" role="group" aria-label={exercise.heading + ' 답 선택'}>
          {exercise.choices.map(choice => <button type="button" data-answer={choice.correct ? 'correct' : 'retry'} aria-pressed="false">{choice.label}</button>)}
        </div>
        <p class="drill-result" role="status" aria-live="polite" hidden></p>
        <a class="drill-detail" href={exercise.href}>공식 자료를 바탕으로 정리한 행동요령 보기 →</a>
      </section>)}
    </div>
    <section class="drill-next" aria-labelledby="drill-next-title">
      <h2 id="drill-next-title">이제 우리 집에 맞게 준비하세요</h2>
      <p>가족 연락 방법을 정하고, 이미 있는 준비물을 먼저 체크하세요. 위치별 대피시설은 정부 공식 지도로 확인하세요.</p>
      <div><a class="btn primary" href="/checklist/">우리 집 준비 체크 →</a><a class="btn secondary" href="/family-card/">가족 연락카드 만들기 →</a></div>
    </section>
    <p class="source-caption">학습용 시나리오이며 실제 재난경보나 위치·건물의 안전을 판정하지 않습니다. 관련 자료: <a href="/sources/">공식 출처 모음</a> · 확인 2026-10-28.</p>
  </div>
  <script>
    document.querySelectorAll('.drill-card').forEach((card) => {
      const buttons = card.querySelectorAll('button[data-answer]');
      const result = card.querySelector('.drill-result');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          const correct = button.getAttribute('data-answer') === 'correct';
          if (result instanceof HTMLElement) {
            result.hidden = false;
            result.classList.toggle('drill-result--correct', correct);
            result.textContent = (correct ? '맞는 첫 행동입니다. ' : '다른 행동을 선택해 보세요. ') + (card.getAttribute('data-explanation') ?? '');
          }
        });
      });
    });
  </script>
  <style>
    .drill-page{padding-bottom:38px}
    .drill-alert{border:1px solid #9a6b4d;border-left:4px solid #edb576;background:#322a2b;color:#f4d9bc;border-radius:12px;padding:17px 19px;line-height:1.7;margin:20px 0}
    .drill-alert strong{color:#ffdda8}
    .drill-alert a{color:#ffd7a0;font-weight:850;text-decoration:underline}
    .drill-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:stretch}
    .drill-card{display:flex;flex-direction:column;min-width:0;background:#1b2c37;border:1px solid #49616b;border-radius:16px;padding:20px}
    .drill-index{color:#f5c78b;font-size:.78rem;font-weight:850}
    .drill-card h2{color:#f5f4ed;font-size:1.18rem;line-height:1.45;margin:10px 0}
    .drill-context{color:#c0d2d6;font-size:.88rem;line-height:1.65;margin:0 0 18px}
    .drill-options{display:grid;gap:9px}
    .drill-options button{font:inherit;text-align:left;cursor:pointer;border:1px solid #526a74;background:#243943;color:#e4f0ed;line-height:1.52;border-radius:10px;padding:11px 13px;min-height:48px;word-break:keep-all;overflow-wrap:break-word}
    .drill-options button:hover,.drill-options button:focus-visible{border-color:#fac78a}
    .drill-options button[aria-pressed="true"]{background:#3a4b43;border-color:#edbb79;color:#fff5e8}
    .drill-result{color:#ffddbd;background:#3a302e;border:1px solid #a07250;border-radius:10px;padding:13px;line-height:1.66;font-size:.86rem;margin:14px 0 0}
    .drill-result--correct{color:#c8f1de;background:#204039;border-color:#669580}
    .drill-detail{display:flex;align-items:center;min-height:44px;color:#b6ead5;font-size:.84rem;font-weight:850;margin-top:auto;padding-top:16px}
    .drill-next{background:#1e3739;border:1px solid #51746b;border-radius:15px;padding:22px;margin:25px 0}
    .drill-next h2{color:#f8e8ca;font-size:1.24rem;margin:0 0 7px}
    .drill-next p{color:#c7d8d6;font-size:.9rem;line-height:1.7}
    .drill-next>div{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:1024px){.drill-grid{grid-template-columns:1fr}}
    @media(max-width:540px){.drill-card{padding:16px}.drill-next{padding:18px}.drill-next .btn{width:100%;text-align:center}}
    @media print{.drill-options button{color:#111!important;border:1px solid #999!important}.drill-card{background:#fff!important;border:1px solid #999!important}.drill-card h2,.drill-context,.drill-index{color:#111!important}}
  </style>
</Base>
