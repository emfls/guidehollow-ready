---
import '../styles/global.css';
import '../styles/night-layout.css';
import { site } from '../site';
import Ga4Analytics from '../components/Ga4Analytics.astro';
interface Props { title?: string; description?: string; noindex?: boolean }
const {title='재난 대비 정보와 준비물 가이드',description=site.description,noindex=false}=Astro.props;
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname,site.url).toString();
const robots = !site.indexingEnabled || noindex ? 'noindex, follow' : 'index, follow';
const path=Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="theme-color" content="#0e151d"/>
 <meta name="description" content={description}/>
 <meta name="robots" content={robots}/>
 <meta name="naver-site-verification" content="4a3c4cef3cedf9582280c00ff70ebff66b9b7de8"/>
 <title>{pageTitle}</title>
 <link rel="canonical" href={canonical}/>
 <meta property="og:type" content="website"/>
 <meta property="og:locale" content="ko_KR"/>
 <meta property="og:site_name" content={site.name}/>
 <meta property="og:title" content={pageTitle}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <link rel="alternate" type="application/rss+xml" title="GuideHollow Ready RSS" href="/rss.xml"/>
</head>
<body>
 <a class="skip-link" href="#main">본문으로 건너뛰기</a>
 <div class="topnote"><div class="container">이 사이트는 실시간 재난 경보 서비스가 아닙니다. 실제 상황에서는 정부 발표와 현장 지시가 우선입니다.</div></div>
 <header class="site-header">
  <div class="container header-inner">
   <a href="/" class="brand" aria-label="GuideHollow Ready 첫 화면">
    <span class="brand-mark" aria-hidden="true">R</span>
    <span class="brand-type"><strong>GUIDEHOLLOW</strong><span>READY <small>재난 대비 생활 가이드</small></span></span>
   </a>
   <nav class="site-nav" aria-label="사이트 메뉴">
    <a href="/" aria-current={path==='/' ? 'page':undefined}>홈</a>
    <a class="nav-emergency" href="/emergency/" aria-current={path==='/emergency/'?'page':undefined}>긴급 행동</a>
    <a href="https://www.safekorea.go.kr/safekorea-kor/flsm/flsm/facilitiesSafteyMap.do" target="_blank" rel="noopener noreferrer">대피소 찾기 ↗</a>
    <a href="/checklist/" aria-current={path==='/checklist/'||path==='/starter-kit/'?'page':undefined}>준비</a>
    <a href="/family-card/" aria-current={path==='/family-card/'||path==='/plan/'||path==='/family-emergency/'?'page':undefined}>가족</a>
   </nav>
  </div>
 </header>
 <main id="main"><slot/></main>
 <footer class="site-footer">
  <div class="container footer-grid">
   <div><strong>GUIDEHOLLOW <span>READY</span></strong><p>상황별 재난 행동요령과<br/>가정의 비상 준비를 위한 안내.</p></div>
   <div class="footer-links"><a href="/about/">사이트 소개·편집 원칙</a><a href="/disclosure/">광고·제휴 고지</a><a href="/privacy/">개인정보 안내</a>{/^G-[A-Z0-9]{6,}$/.test(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID??'') && <button id="ga4-settings" class="ga4-footer-settings" type="button">방문 통계 설정</button>}<a href="/sources/">공식 자료 모음</a><a href="/rss.xml">RSS 구독</a></div>
  </div>
  <div class="container footer-bottom">© 2026 GuideHollow Ready · 비공식 민간 정보 사이트 · <a href="https://guidehollow.com/" rel="noopener noreferrer">GuideHollow</a></div>
 </footer>

 <nav class="mobile-tabbar" aria-label="모바일 빠른 메뉴">
  <a href="/" aria-current={path==='/'?'page':undefined}><span aria-hidden="true">⌂</span><small>홈</small></a>
  <a href="/emergency/" aria-current={path==='/emergency/'||path==='/situations/'?'page':undefined}><span aria-hidden="true">!</span><small>긴급</small></a>
  <a href="https://www.safekorea.go.kr/safekorea-kor/flsm/flsm/facilitiesSafteyMap.do" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">◎</span><small>대피소</small></a>
  <a href="/checklist/" aria-current={path==='/checklist/'||path==='/starter-kit/'?'page':undefined}><span aria-hidden="true">☑</span><small>준비</small></a>
  <a href="/family-card/" aria-current={path==='/family-card/'||path==='/plan/'||path==='/family-emergency/'?'page':undefined}><span aria-hidden="true">▤</span><small>가족</small></a>
 </nav>
 <Ga4Analytics/>
</body>
</html>
