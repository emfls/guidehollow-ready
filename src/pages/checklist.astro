@media(max-width:740px){.check-backup{padding:15px}.check-backup-actions{flex-direction:column;align-items:stretch}.check-backup-actions .btn{width:100%}.family-options{grid-template-columns:1fr}.family-select{padding:16px}.family-option{min-height:54px}.check-actions{gap:10px}.check-actions button{min-height:44px}}
