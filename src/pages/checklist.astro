.copy-fallback-wrap{border:1px solid #547879;background:#1c3539;padding:14px;border-radius:12px;margin:0 0 18px}
.copy-fallback-wrap[hidden]{display:none!important}
.copy-fallback-wrap label{display:block;color:#e9f2ed;margin:0 0 9px;font-size:.86rem;font-weight:700}
.copy-fallback-wrap textarea{display:block;width:100%;min-height:140px;max-width:100%;resize:vertical;background:#11252e;border:1px solid #819da3;border-radius:8px;color:#f4f8f6;padding:10px;font:inherit;line-height:1.6}
