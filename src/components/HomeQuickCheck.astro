---
import { affiliateOffers, affiliatePhoto } from '../data/affiliate-product-visuals';
import ProductPhoto from './ProductPhoto.astro';
const checks=[
 {id:'water',icon:'💧',question:'마실 물과 기본 위생용 물이 있나요?',offer:'water',name:'아이시스 무라벨 생수 2L × 12개',reason:'3일간 마실 물과 기본 위생용 물을 인원에 맞춰 계산하세요',caveat:'24L 묶음이 가족의 전체 필요량과 일치한다는 뜻은 아닙니다',guide:'/buying/food/'},
 {id:'food',icon:'🥫',question:'전기가 없어도 바로 먹을 식품이 있나요?',offer:'tuna',name:'동원 라이트 스탠다드 참치 100g × 10개',reason:'조리 없이 먹는 상온 식품을 서로 다른 종류로 준비하세요',caveat:'참치 한 종류로 영양을 충족할 수 없고 알레르기·소비기한 확인이 필요합니다',guide:'/buying/food/'},
 {id:'light',icon:'🔦',question:'건전지형 손전등이 정상 작동하나요?',offer:'flashlight',name:'페닉스 E20 V2.0 손전등',reason:'휴대전화 배터리를 아끼면서 정전 시 주변을 밝힐 수 있어요',caveat:'AA 건전지 2개의 준비 및 동봉 여부와 작동 상태를 확인하세요',guide:'/reviews/fenix-e20-v2-flashlight/'},
 {id:'radio',icon:'📻',question:'인터넷 없이 소식을 들을 라디오가 있나요?',offer:'radio',name:'소니 ICF-P26 블랙 라디오',reason:'휴대전화·데이터 통신에 문제가 생기더라도 방송을 들을 수 있어요',caveat:'AA 건전지 2개와 지역 AM/FM 수신 가능 여부를 먼저 확인하세요',guide:'/reviews/emergency-am-fm-radios/'},
 {id:'power',icon:'🔋',question:'충전된 보조배터리와 케이블이 있나요?',offer:'battery',name:'삼성 EB-P3401 베이지 10,000mAh',reason:'정전 중 휴대전화의 연락·경보 확인 시간을 늘리는 예비 전원입니다',caveat:'케이블·휴대전화 호환성, 남은 충전량과 이상 발열을 점검하세요',guide:'/reviews/emergency-power-banks-10000-vs-20000/'},
] as const;
---
<section class="home-fast-check" id="home-fast-check" aria-labelledby="home-fast-check-title">
 <div class="home-fast-check-head">
  <div>
   <span class="section-label">평상시 대비 · 72시간</span>
   <h2 id="home-fast-check-title">3일 대비, 우리 집은 얼마나 준비됐을까요?</h2>
   <p>5가지만 빠르게 확인하세요. <strong>확인이 필요한 품목만</strong> 아래에 연결합니다. 답변은 서버로 전송하거나 체크리스트에 저장하지 않습니다.</p>
  </div>
  <a class="home-fast-protocol-link" href="/protocols/">3일~90일 준비 계획 →</a>
 </div>
 <div class="home-fast-questions" role="group" aria-label="우리 집 3일 대비 빠른 점검">
  {checks.map((item,i)=><fieldset class="home-fast-question" data-home-fast-question={item.id}>
   <legend><span aria-hidden="true">{item.icon}</span><span class="home-fast-number">{String(i+1).padStart(2,'0')}</span>{item.question}</legend>
   <div class="home-fast-options">
    <label><input type="radio" name={'home-check-'+item.id} value="have"/><span>갖고 있어요</span></label>
    <label><input type="radio" name={'home-check-'+item.id} value="need"/><span>확인 필요</span></label>
   </div>
  </fieldset>)}
 </div>
 <div class="home-fast-progress"><span id="home-fast-count">0 / 5항목 선택</span><button type="button" id="home-fast-reset">다시 점검</button></div>
 <div class="home-fast-results" id="home-fast-results" hidden aria-live="polite">
  <div class="home-fast-results-head"><h3 id="home-fast-results-title">확인할 상품</h3><p id="home-fast-results-status" role="status">답변을 선택하면 해당 품목이 표시됩니다.</p></div>
  <div class="home-fast-result-grid">
   {checks.map(item=><article class="home-fast-result-card" data-home-fast-product={item.id} hidden>
    <div class="home-fast-result-photo"><ProductPhoto src={affiliatePhoto(item.offer)} alt={affiliateOffers[item.offer].alt+' 제품 사진'} offer={item.offer} fallback={item.icon}/></div>
    <div class="home-fast-result-copy">
      <span class="home-fast-match-label">확인 필요 · 대체 구매 예시</span>
      <h4>{item.name}</h4>
      <p>{item.reason}</p>
      <small>{item.caveat}</small>
      <div class="home-fast-result-actions"><a href={item.guide} class="home-fast-learn">선택 기준 →</a><a href={affiliateOffers[item.offer].url} class="home-fast-buy" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={item.name+' 쿠팡에서 구매하기 (새 창)'}>구매하기 ↗</a></div>
    </div>
   </article>)}
  </div>
  <p id="home-fast-all-ready" class="home-fast-all-ready" hidden>모두 '갖고 있어요'로 선택했습니다. 수량·작동 상태·소비기한과 가족별 필요량을 확인해야 실제 준비 상태를 판단할 수 있습니다.</p>
  <p class="home-fast-disclosure"><strong>제휴 안내</strong> — 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 링크는 등록 당시 모델을 확인한 상품 예시이며 직접 사용한 검증 후기는 아닙니다. 구매 전에 옵션·가격·재고·배송을 확인하세요. <strong>상품을 샀다고 재난 대비가 완료되는 것은 아닙니다.</strong></p>
 </div>
 <div class="home-fast-check-foot"><span>미체크·‘확인 필요’는 미보유 확정이 아닙니다</span><a href="/checklist/">22항목 상세 체크리스트에 기록하기 →</a></div>
</section>
<script>
const fields=[...document.querySelectorAll<HTMLFieldSetElement>('[data-home-fast-question]')];
const results=document.querySelector<HTMLElement>('#home-fast-results');
const cards=[...document.querySelectorAll<HTMLElement>('[data-home-fast-product]')];
const count=document.querySelector<HTMLElement>('#home-fast-count');
const status=document.querySelector<HTMLElement>('#home-fast-results-status');
const allReady=document.querySelector<HTMLElement>('#home-fast-all-ready');
const reset=document.querySelector<HTMLButtonElement>('#home-fast-reset');
function updateQuickCheck(){
 let answered=0,needs=0;
 for(const field of fields){
  const radio=field.querySelector<HTMLInputElement>('input[type="radio"]:checked');
  if(radio)answered++;
  if(radio?.value==='need')needs++;
  field.dataset.answered=radio?.value||'';
 }
 for(const card of cards){
  const field=fields.find(f=>f.dataset.homeFastQuestion===card.dataset.homeFastProduct);
  card.hidden=field?.dataset.answered!=='need';
 }
 if(count)count.textContent=answered+' / '+fields.length+'항목 선택';
 if(results)results.hidden=answered===0;
 if(status)status.textContent=needs>0?'추가 확인할 품목 '+needs+'가지 · 집에 있는 물품과 비교한 후 필요한 경우에만 구매하세요':answered===fields.length?'선택한 항목은 모두 보유 중입니다 · 실제 수량·상태를 점검하세요':'현재 선택한 항목에는 구매 안내가 없습니다 · 다른 항목도 확인해 보세요';
 if(allReady)allReady.hidden=needs!==0||answered!==fields.length;
}
fields.forEach(f=>f.addEventListener('change',updateQuickCheck));
reset?.addEventListener('click',()=>{for(const r of document.querySelectorAll<HTMLInputElement>('.home-fast-question input[type="radio"]'))r.checked=false;updateQuickCheck();});
updateQuickCheck();
</script>
