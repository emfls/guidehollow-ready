---
import Base from '../layouts/Base.astro';

const official = {
 emergency: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EB%B9%84%EC%83%81%EC%82%AC%ED%83%9C&category=stateOfEmergency&menuSn=4',
 chemical: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%ED%99%94%EC%83%9D%EB%B0%A9%EB%AC%B4%EA%B8%B0&category=chemicalandBiologicalWeapons&menuSn=4',
 biological: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EB%B9%84%EC%83%81%EC%82%AC%ED%83%9C&category=stateOfEmergency&menuSn=4',
 nuclear: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EB%B9%84%EC%83%81%EC%82%AC%ED%83%9C&category=stateOfEmergency&menuSn=4',
 diseaseContact: 'https://www.kdca.go.kr/kdca/2777/subview.do',
 civilAlarmLite: 'https://www.safekorea.go.kr/safekorea-kor/em/emergency/emergency_df1.html',
 radiationDecon: 'https://www.cdc.gov/radiation-emergencies/prevention/self-decontaminate.html',
 radiationFAQ: 'https://www.cdc.gov/radiation-emergencies/faq/index.html',
 chemicalAccident: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%ED%99%94%ED%95%99%EC%82%AC%EA%B3%A0%EC%9E%AC%EB%82%9C&category=chemicalAccidentDisaster&menuSn=4',
 civilAlarm: 'https://www.safekorea.go.kr/safekorea-kor/edtr/clns/cdal/civilDefenseAlarm.do?menuSn=57',
 alarms: 'https://www.mois.go.kr/frt/sub/a06/b12/civildefensework/screen.do',
 shelter: 'https://www.safekorea.go.kr/safekorea-kor/flsm/flsm/facilitiesSafteyMap.do',
 shelterBackup: 'https://www.safekorea.go.kr/safekorea-kor/em/shelter/emergency_df2.html',
 waterFacility: 'https://www.safekorea.go.kr/safekorea-kor/em/shelter/emergency_df3.html',
 earthquake: 'https://www.weather.go.kr/w/wnuri-eqk-vol/eqk/warning.do',
 tsunami: 'https://safekorea.go.kr/safekorea-kor/em/emergency/emergency_eq3.html',
 tsunamiNotice: 'https://www.kma.go.kr/kma/flexer/html/press/2026/07/29/ATC202607290854052_afb10121-1724-4b48-9b59-309334531167.hwp.files/Sections1.html',
 landslide: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EC%82%B0%EC%82%AC%ED%83%9C&category=landSlide&menuSn=4',
 wildfire: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?category=forestFires&menuSn=4',
 fire: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%ED%99%94%EC%9E%AC&category=fires&menuSn=4',
 flood: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EC%B9%A8%EC%88%98&category=inundation&menuSn=4',
 power: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EC%A0%95%EC%A0%84+%EB%B0%8F+%EC%A0%84%EB%A0%A5%EB%B6%80%EC%A1%B1&category=powerOutagesandShortages&menuSn=4',
 water: 'https://safecity.seoul.go.kr/bhvr/livesafe/bhvrLivesafeSingularList.page?menuId=MENU_SSNS_000103',
} as const;

const situations = [
 {id:'warning',name:'경계경보',time:'공격이 예상될 때',points:['방송·재난문자로 경보 종류와 지역, 대피 지시를 확인합니다.','가까운 민방위 대피시설과 이동 경로를 점검하고, 어린이·노약자는 안내에 따라 미리 대피를 준비합니다.','비상물품을 준비하고 주변 사람에게 경보 내용을 알립니다.'],why:'경계경보와 공습경보의 행동은 다릅니다. 정부의 대피 지시가 있으면 준비보다 대피가 우선입니다.',href:official.emergency},
 {id:'air-raid',name:'공습경보·포격',time:'공격이 임박하거나 진행될 때',points:['가까운 민방위 대피시설, 지하철역·지하시설 또는 콘크리트 건물 안쪽의 창문 없는 곳으로 신속히 대피합니다.','고층 건물에서는 엘리베이터 대신 계단을 이용합니다. 운전 중이라면 안전한 곳에 정차한 뒤 대피합니다.','대피한 뒤에는 정부 안내방송을 계속 확인하고 현장 관리자의 지시를 따릅니다.'],why:'호우·침수 위험이 있는 저지대 지하공간은 피하고, 지역 상황에 맞는 안전한 곳을 선택해야 합니다. 모든 지하공간이 공식 지정 대피소는 아닙니다.',href:official.emergency},
 {id:'chemical',name:'화학 공격·화생방경보',time:'화학물질 오염이 확인되거나 우려될 때',points:['경보 내용을 확인하고 오염 지역과 외부 공기의 유입을 피합니다. 화학 공격 시에는 외부 공기를 차단할 수 있는 높은 층의 실내 공간이 안내됩니다.','실내에서는 창문·출입문을 닫고 외부 공기를 들여오는 환기·냉방기기 등을 멈춥니다.','공습 때문에 지하에 대피 중이라도 화학 공격이 확인되면 동일한 지하 대피가 적절하지 않을 수 있으므로 정부·현장 지시에 따라 비오염 구역으로 이동합니다.'],why:'일반 마스크나 젖은 수건은 화학작용제 전용 방독면과 같은 보호 성능이 아닙니다. 무작정 지하로 이동하지 마세요.',href:official.chemical},
 {id:'chemical-accident',name:'산업시설 화학사고·유해물질 누출',time:'공장·운송시설 등에서 화학물질 유출이 발생했을 때',points:['누출을 직접 발견했다면 오염 현장에서 최대한 멀리 벗어나 안전한 장소에서 119에 신고합니다. 사고 위치와 보이는 색·냄새·증상 등 확인 가능한 상황을 알립니다.','재난문자·방송으로 사고 소식을 받았다면 별도 대피 지시가 없는 한 안전한 실내에 머물며 외부 공기 유입을 막고 추가 안내를 확인합니다. 건물 안에서 누출됐다면 오염된 공간에서 벗어나야 합니다.','주민대피명령이 내려오면 경찰·지자체가 안내한 경로와 장소로 이동합니다. 복귀 후에는 오염 가능성이 있는 식수·음식물을 먹거나 물건을 맨손으로 만지지 말고 후속 안내를 따릅니다.'],why:'사고 현장을 직접 목격한 경우와 외부 사고를 재난문자로 안내받은 경우의 첫 행동은 다릅니다. 이동 방향은 사고 위치와 풍향·현장 통제에 따라 달라지며, 일반 마스크는 유해가스용 보호구가 아닙니다.',href:official.chemicalAccident},
 {id:'biological',name:'생물학 공격 의심',time:'화생방경보·보건당국 안내 또는 오염 의심 물질 발견 시',points:['정부·지자체의 생물학 공격 관련 경보를 받았다면 오염 우려가 있는 사람·물질·장소와 접촉하지 말고, 안내된 대피시설이나 외부 공기 유입을 줄일 수 있는 안전한 실내 공간으로 이동합니다.','다른 지역으로 임의 이동하지 말고 위생을 유지하며 정부·보건당국의 감염 확인·검사·치료·예방접종 지시를 따릅니다. 증상만으로 생물학 공격 여부를 단정하지 않습니다.','의심스러운 우편물·가루·분말을 발견했다면 개봉·흔들기·청소·접촉을 피하고 다른 사람의 접근을 막습니다. 안전한 곳에서 관할 보건소 또는 질병관리청 1339에 신고·상담하고 현장 지시를 따릅니다. 즉각적인 위험·구조가 필요하면 119에 신고합니다.'],why:'생물학 공격과 일반 감염병은 구분해야 합니다. 의심되는 증상이나 물질만으로 공격을 확정하거나, 임의로 약·백신을 복용·접종하지 마세요.',href:official.biological},
 {id:'nuclear',name:'핵 경보·방사능 낙진',time:'핵 경보가 발령되거나 폭발·낙진 위험을 알게 됐을 때',points:['핵 경보를 받았다면 가까운 민방위 대피시설이나 지하시설, 두꺼운 콘크리트 건물의 창문 없는 안쪽으로 신속히 대피합니다. 폭발 섬광이 이미 보이고 피할 시간이 없다면 주변 엄폐물을 이용해 즉시 엎드려 눈·귀를 보호합니다.','충격파와 파편 낙하가 멈춘 뒤에는 낙진에 대비해 지하 깊은 곳이나 건물 중앙의 외벽·지붕에서 먼 공간에 머물고, 공식 방송으로 이동 지시를 확인합니다.','낙진이 옷·피부에 묻은 것으로 의심되면 안전한 실내에서 겉옷을 벗고 부드럽게 씻습니다. 이동·귀가·대피 종료 시점은 정부와 현장 구조기관의 안내를 따릅니다.'],why:'핵 경보 발령과 이미 폭발한 상황의 첫 행동은 다릅니다. 피폭과 방사성 물질 오염도 구별해야 하며, 민방공 경보해제가 곧 방사능 오염 해제라는 뜻은 아닙니다.',href:official.nuclear},
 {id:'all-clear',name:'민방공 경보해제',time:'정부가 경보해제를 발표했을 때',points:['경보해제는 공식 음성방송 등으로 안내됩니다. 사이렌이 멈췄다는 사실만으로 해제를 판단하지 말고 방송·재난문자에서 해제 지역과 후속 지시를 확인합니다.','안전한 범위에서 부상자 구조를 돕되, 추가 공격 가능성에 대비하고 정부 방송을 계속 듣습니다.','오염·화재·건물 손상 위험이 남아 있다면 함부로 밖으로 나가거나 귀가하지 말고 해당 위험에 대한 별도 안내를 따릅니다.'],why:'경보해제는 추가 공격이 예상되지 않는다는 경보 단계입니다. 모든 지역의 통행·시설 이용·오염 위험이 해소됐다는 보증이 아닙니다.',href:official.civilAlarm},
 {id:'earthquake',name:'지진',time:'지면이 흔들릴 때',points:['흔들리는 동안 튼튼한 탁자 아래 등에서 머리와 몸을 보호합니다.','흔들림이 멈추면 계단으로 이동하고, 건물 밖에서는 건물·간판·유리창과 거리를 둡니다.','운동장·공원 등 낙하물 위험이 적은 넓은 장소에서 여진과 공식 안내를 확인합니다.'],why:'해안가에서 지진을 느끼거나 지진해일 특보가 발령되면 일반 지진 옥외대피장소가 아니라 지진해일 긴급대피장소 또는 높은 곳으로 이동해야 합니다.',href:official.earthquake},
 {id:'tsunami',name:'지진해일',time:'해안에서 지진을 느끼거나 지진해일 특보가 발령됐을 때',points:['해안이나 바다와 연결된 하천 주변에서 지진을 느끼면 특보·재난문자를 기다리지 말고 즉시 해안에서 벗어나 지진해일 긴급대피장소 또는 안전한 높은 곳으로 이동합니다. 지진해일 주의보·경보를 받아도 같은 대피 원칙을 따릅니다.','높은 곳에 도달할 시간이 없다면 가까운 튼튼한 건물의 3층 이상 또는 해발고도 10m 이상 언덕 등 위험을 피할 수 있는 곳으로 대피합니다. 낮은 곳의 일반 지진 옥외대피장소나 민방위 지하 대피소로 무조건 이동하지 않습니다.','지진해일은 여러 차례 반복될 수 있습니다. 최초 파도가 지나도 내려가지 말고 기상청 특보 해제와 지자체·현장 안내를 확인합니다. 특보 해제 시 별도 재난문자가 발송되지 않을 수 있으므로 문자 수신 여부만으로 대피 종료를 판단하지 않습니다.'],why:'해안에서 지진을 느꼈을 때는 특보 발표 전에 지진해일이 도달할 수 있어 대피를 늦추면 안 됩니다. 지진해일정보는 주의 안내이며, 주의보·경보와 문자 종류가 다릅니다.',href:official.tsunami},
 {id:'wildfire',name:'산불',time:'산불이 접근하거나 대피 안내를 받으면',points:['산불이 가까이 오거나 대피 안내를 받았다면 신고나 짐 정리 때문에 출발을 늦추지 말고 산불 진행 경로에서 벗어나 지정된 안전한 장소로 즉시 이동합니다. 멀리서 연기·불꽃을 발견했다면 안전한 곳에서 119 또는 112에 신고합니다.','산행·야영 중에는 활동을 중단하고 산불 진행 방향과 계곡부를 피하여 산에서 멀어지는 안전한 경로로 이동합니다. 대피 중에는 재난문자·방송과 현장 지시를 확인합니다.','산불이 진화돼도 곧바로 귀가하지 말고 지자체의 복귀 안내를 확인합니다. 귀가 후에는 상수도·전기설비 손상과 남은 불씨 위험을 살펴보고 이상이 있으면 신고합니다.'],why:'산불 대피는 산비탈의 높은 곳으로 이동하는 방식이 아닙니다. 불길이 꺼진 뒤에도 지자체의 귀가 안내와 전기·수도·잔불 위험을 확인하세요.',href:official.wildfire},
 {id:'fire',name:'화재·연기',time:'우리 집 또는 아파트 다른 곳에서 불이 났을 때',points:['먼저 가족에게 화재 사실을 알리고 불이 난 곳과 우리 집에 연기·불꽃이 들어오는지를 확인합니다. 우리 집에서 불이 났고 안전하게 나갈 수 있으면 즉시 계단으로 대피합니다. 다른 곳에서 불이 났지만 우리 집에 연기·불꽃이 들어오지 않으면 무리하게 복도로 나가지 않고 실내에서 상황을 살핍니다.','우리 집 또는 다른 곳의 화재로 대피가 필요하다면 손등으로 문손잡이의 열과 복도·계단의 연기를 확인합니다. 안전한 경로가 있을 때만 낮은 자세로 계단을 이용하고, 나갈 때 출입문을 닫습니다. 엘리베이터는 이용하지 않습니다.','현관·복도·계단에 화염이나 짙은 연기가 있어 나갈 수 없다면 세대 내 대피공간·경량칸막이·하향식피난구 등 설치된 피난시설을 이용합니다. 그런 시설이 없으면 화염·연기에서 멀리 떨어져 문을 닫고 틈새를 막은 다음 119에 정확한 위치를 알립니다.'],why:'아파트의 다른 세대에서 불이 났더라도 우리 집에 연기·불꽃이 없으면 무리한 대피보다 실내 대기·창문 닫기가 안전할 수 있습니다. 소방대·관리자 방송과 실제 연기 유입을 계속 확인하세요.',href:official.fire},
 {id:'flood',name:'집중호우·침수',time:'물이 차오르거나 대피 지시가 있을 때',points:['반지하·지하주차장·지하역사 등에 물이 들어오거나 하수구가 역류하면 즉시 안전한 높은 곳으로 대피합니다. 물이 조금이라도 유입된 지하계단·지하주차장에는 차량 확인·이동을 위해 들어가지 않습니다.','도로·지하차도에 물이 흘러들면 절대 진입하지 않습니다. 침수된 길이나 하천을 무리하게 건너지 말고 우회하며, 지자체 대피 지시가 있으면 즉시 따릅니다.','안전하게 대피한 뒤 침수된 전기설비·가스시설과 고인 물에 접근하지 않습니다. 귀가 전 현장 안전과 상하수도·전기 관련 안내를 확인합니다.'],why:'지하 공간에는 물이 빠르게 차올라 출입문이 열리지 않을 수 있습니다. 물이 유입되기 시작했다면 차를 옮기거나 물건을 챙기느라 지하로 다시 내려가지 마세요.',href:official.flood},
 {id:'landslide',name:'산사태',time:'집중호우 중 산비탈·계곡 주변이 위험할 때',points:['산사태가 이미 발생했거나 대피 명령이 내려오면 산사태 진행 방향과 계곡부를 벗어나 지자체 지정 대피장소로 즉시 이동합니다. 급박할 때는 산사태 방향에서 멀어지는 가장 가까운 안전한 높은 곳으로 대피합니다.','집중호우 중 산지에서는 균열·돌 굴러내림·계곡 상류의 갑작스러운 흙탕물 등 위험 신호와 산사태 예보를 확인하되, 현장 위험이나 대피 지시가 있으면 확인보다 대피를 우선합니다.','하천·계류나 고압전선 근처를 무리하게 통과하지 않습니다. 건물에서 나갈 수 없다면 가능한 높은 층의 산과 먼 공간에서 머리를 보호하고 119에 구조를 요청합니다.'],why:'호우·침수 때의 높은 곳과 산사태 대피 방향은 다릅니다. 산사태가 흘러내리는 경로를 거슬러 올라가지 말고 그 방향에서 벗어나야 합니다. 대피 명령이 있으면 무리한 재산 보호보다 대피를 우선합니다.',href:official.landslide},
 {id:'power',name:'정전',time:'전기 공급이 멈출 때',points:['손전등이나 휴대전화 조명으로 안전을 확보하고, 우리 집만 정전인지 주변도 정전인지 확인합니다. 라디오·관리사무소·한국전력의 안내로 정전 범위를 확인하세요.','승강기에 갇혔다면 비상통화장치로 구조를 요청하고 문을 강제로 열지 않습니다. 비상통화가 연결되지 않으면 119에 건물 위치와 승강기 식별번호를 알립니다.','정전 문의·전기 상담은 한국전력 123에 연락합니다. 전기가 돌아오면 전기기기를 한꺼번에 켜지 말고 안전을 확인하며 순차적으로 사용합니다.'],why:'비상조명은 손전등을 우선 활용하세요. 실내·차고·베란다 등 환기가 불충분한 곳에서 발전기·숯·연소기구를 사용하면 일산화탄소 중독이나 화재가 발생할 수 있습니다.',href:official.power},
 {id:'water',name:'단수',time:'수돗물 공급이 멈출 때',points:['단수가 예고됐으면 깨끗한 용기에 필요한 물을 미리 받아두고, 갑자기 끊겼다면 건물 관리사무소와 관할 지자체 수도사업자 공지에서 영향 지역과 복구 안내를 확인합니다.','보관한 음용수와 생활용수를 용도별로 아껴 쓰고, 지자체에서 안내하는 급수차·병물 공급 및 비상급수시설의 실제 이용 가능 여부를 확인합니다. 수질이 의심되는 물은 마시지 않습니다.','급수 재개 뒤 탁수·이물질이 나오면 바로 마시지 말고 수도사업자의 수질·음용 안내를 확인합니다. 맑은 물이 나오는지 확인하되 지역 안내 없이 음용 가능하다고 판단하지 마세요.'],why:'단수 범위·복구 시각·급수차 운영은 지역마다 다릅니다. 서울시 단수 행동요령은 일반 참고자료이며, 실제 단수·급수 정보는 해당 지역 수도사업자와 지자체가 우선입니다.',href:official.water}
] as const;
const quickSafetyText: Record<string,{first:string;caution:string}> = {
  'warning': { first: "재난문자·방송에서 경보 종류와 지역을 확인하고, 대피 안내에 맞춰 준비하세요.", caution: "정부의 대피 지시가 있으면 물품 준비보다 대피가 우선입니다." },
  'air-raid': { first: "가까운 민방위 대피시설이나 튼튼한 건물 안쪽으로 신속히 이동하세요.", caution: "침수 위험이 있는 지하공간은 피하고, 현장 지시를 따르세요." },
  'chemical': { first: "오염된 곳을 피하고, 안전한 실내에서는 창문과 외부 환기를 차단하세요. 이동은 당국 지시에 따르세요.", caution: "공습과 대피 장소가 다를 수 있으니 무조건 지하로 가지 마세요." },
  'chemical-accident': { first: "누출 현장에 있다면 멀리 벗어나 119에 신고하세요. 재난문자를 받았다면 실내 대기·대피 지시를 확인하세요.", caution: "누출 현장에 있는 사람과 멀리서 재난문자를 받은 사람의 행동은 다릅니다." },
  'biological': { first: "의심 물질은 만지거나 열지 마세요. 경보를 받았다면 보건당국의 안내에 따라 접촉과 이동을 줄이세요.", caution: "임의로 약을 먹거나 예방접종하지 말고 의심 물질을 발견하면 접근을 막고 신고하세요." },
  'nuclear': { first: "핵 경보 시 지하 또는 두꺼운 건물 안쪽으로 대피하세요. 이미 섬광을 봤다면 즉시 엎드려 몸을 보호하세요.", caution: "폭발 직후와 낙진 단계의 행동은 다릅니다. 경보해제가 오염 해제는 아닙니다." },
  'all-clear': { first: "공식 방송에서 경보해제 지역과 후속 지시를 확인하세요.", caution: "사이렌이 멈췄더라도 오염·화재·건물 손상이 남았다면 밖으로 나가지 마세요." },
  'earthquake': { first: "흔들리는 동안 탁자 아래 등에서 머리와 몸을 보호하세요.", caution: "해안가라면 흔들림 후 지진해일 위험을 따로 확인하세요." },
  'tsunami': { first: "해안에서 지진을 느꼈다면 특보를 기다리지 말고 즉시 높은 곳이나 지정 대피장소로 이동하세요.", caution: "낮은 지하 대피소는 피하고, 첫 파도가 지나도 당국 지시 전에는 돌아오지 마세요." },
  'wildfire': { first: "산불이 가까워지거나 대피 지시가 오면 짐을 챙기느라 지체하지 말고 안내된 경로로 이동하세요.", caution: "산불이 잦아들어도 지자체 귀가 안내 전에는 돌아가지 마세요." },
  'fire': { first: "우리 집에 불이 나고 안전한 출구가 있으면 계단으로 대피하세요. 다른 집의 불이면 연기 유입과 안내를 확인하세요.", caution: "복도·계단에 짙은 연기가 있으면 무리하게 나가지 말고 대피공간에서 119에 위치를 알리세요." },
  'flood': { first: "반지하·지하주차장에 물이 들어오기 시작하면 즉시 높은 곳으로 대피하세요.", caution: "침수된 지하공간·도로에 차나 물건을 찾으러 들어가지 마세요." },
  'landslide': { first: "산사태가 발생하거나 대피 지시가 오면 진행 방향과 계곡을 피해 안전한 곳으로 이동하세요.", caution: "흙과 돌이 흘러내리는 길을 거슬러 올라가거나 계곡 쪽으로 이동하지 마세요." },
  'power': { first: "손전등으로 주변을 밝히고 정전 범위를 확인하세요. 승강기에 갇혔다면 비상통화나 119로 구조를 요청하세요.", caution: "승강기 문을 강제로 열지 말고 실내에서는 발전기·숯 등을 쓰지 마세요." },
  'water': { first: "마실 물을 확보하고 지자체·수도사업자의 단수·복구 안내를 확인하세요.", caution: "수질이 의심되거나 탁한 수돗물은 안내 없이 마시지 마세요." }
};
---
<Base title="재난 상황별 행동요령" description="공습·민방공 경보와 화학 공격·화학사고·핵·지진·지진해일·산사태·산불·화재·침수 등 상황별 핵심 행동을 한국 공식 지침에 따라 안내합니다.">
<div class="container">
 <header class="page-intro"><span class="eyebrow">IN AN EMERGENCY</span><h1>경보 종류를 확인하고 <em>상황에 맞게 대피하세요</em></h1><p>미리 읽어두는 행동요령입니다. 현재 경보를 표시하는 페이지가 아니며, 실제 상황에서는 재난문자·공공방송·현장 지시를 우선합니다.</p></header>
 <div class="emergency-panel"><div><span class="tag">가장 먼저</span><strong>공습·화학 공격·화학사고·침수는 대피 장소와 이동 지시가 다릅니다</strong><p>경보 이름·위험 지역·실내 대기 또는 이동 지시를 확인하세요. 침수 위험이 있는 지하공간으로 무조건 내려가지 말고, 화학사고에서도 임의로 층수를 결정하지 마세요.</p></div><a class="btn primary" href={official.emergency} target="_blank" rel="noopener noreferrer">국민안전24 행동요령 ↗</a></div>
 
 <nav class="situation-shortcuts" aria-label="상황별 행동요령 바로가기">
  <strong>상황 바로 찾기</strong>
  <div>{situations.map(item=><a href={'#'+item.id}>{item.name}<span aria-hidden="true">↓</span></a>)}</div>
 </nav>
 <div class="situation-list situation-list--brief">
  {situations.map((item,i)=><section class="situation-card situation-card--brief" id={item.id} aria-labelledby={item.id+'-title'}>
   <div class="situation-heading"><span class="situation-number">{String(i+1).padStart(2,'0')}</span><div><small>{item.time}</small><h2 id={item.id+'-title'}>{item.name}</h2></div></div>
   <div class="first-action"><span>먼저 할 일</span><p>{quickSafetyText[item.id]?.first ?? item.points[0]}</p></div>
   <p class="situation-note situation-note--visible"><strong>주의</strong> {quickSafetyText[item.id]?.caution ?? item.why}</p>
   <details class="action-details">
    <summary>자세한 행동 단계·주의사항 보기 <span aria-hidden="true">⌄</span></summary>
    <ol>{item.points.map(p=><li>{p}</li>)}</ol>
    <p class="situation-source-caution"><strong>추가 주의:</strong> {item.why}</p>
   </details>
   <a href={item.href} target="_blank" rel="noopener noreferrer" class="text-link">{item.id==='biological' ? '국민안전24 원문 — 「생물학 무기 공격 시 행동 요령」 찾기 ↗' : item.id==='nuclear' ? '국민안전24 원문 — 「핵 경보 발령 시 행동 요령」 찾기 ↗' : item.id==='earthquake' ? '기상청 지진 속보·대피요령 확인 ↗' : item.id==='water' ? '서울시 일반 단수 행동요령(지역별 단수정보 아님) ↗' : '정부·공식 안내 원문 확인 ↗'}</a>
  </section>)}
 </div>
 <section class="readable" id="alarm-signals" aria-labelledby="alarm-signals-title">
  <h2 id="alarm-signals-title">민방공 경보는 사이렌 소리만으로 구분하지 마세요</h2>
  <p>행정안전부에 따르면 <strong>공습경보와 핵 경보는 모두 1분 사이렌과 음성방송</strong>을 사용합니다. 같은 사이렌이 울릴 수 있으므로 반드시 <strong>방송·재난문자에 표시된 경보 종류와 대상 지역</strong>을 확인해야 합니다. 직접적인 공격·파편 등 급박한 위험에서는 확인하느라 보호 행동을 늦추지 마세요.</p>
  <p class="table-scroll-note" id="alarm-table-help">모바일에서는 표를 좌우로 밀어 확인하세요. 키보드로도 표 영역을 선택해 가로로 이동할 수 있습니다.</p>
  <div class="comparison-scroll" role="region" aria-labelledby="alarm-signals-title" aria-describedby="alarm-table-help" tabindex="0">
   <table>
    <caption>민방공 경보별 공식 전달 방식 — 행정안전부 안내 기준</caption>
   <thead><tr><th scope="col">경보 종류</th><th scope="col">주요 신호 방법</th><th scope="col">확인할 내용</th></tr></thead>
   <tbody>
    <tr><th scope="row">경계경보</th><td>음성방송</td><td>대피 준비·사전 이동 지시</td></tr>
    <tr><th scope="row">공습경보</th><td>1분 사이렌 + 음성방송</td><td>공습 대상 지역·즉시 대피 지시</td></tr>
    <tr><th scope="row">화생방경보</th><td>음성방송</td><td>오염 위험·실내 차단 또는 이동 지시</td></tr>
    <tr><th scope="row">핵 경보</th><td>1분 사이렌 + 음성방송</td><td>핵 경보 해당 지역·실내 대피 지시</td></tr>
    <tr><th scope="row">경보해제</th><td>음성방송</td><td>해제 지역·추가 위험 및 이동 허가 여부</td></tr>
   </tbody>
   </table>
  </div>
  <p>방송 내용을 들을 수 있다면 <strong>① 경보 종류 ② 발령 지역 ③ 지금 해야 할 행동 ④ 후속 안내</strong>를 확인하세요. TV·라디오·재난문자와 현장 안내를 함께 참고하고, 불명확한 상황에서 소문이나 녹음된 사이렌만 믿고 이동하지 마세요.</p>
  <p><a href={official.civilAlarm} target="_blank" rel="noopener noreferrer">국민안전24 민방위 경보 종류·신호 원문 ↗</a> · <a href={official.alarms} target="_blank" rel="noopener noreferrer">행정안전부 경보신호 기준 ↗</a> · <a href={official.civilAlarmLite} target="_blank" rel="noopener noreferrer">공식 경량 행동요령 ↗</a></p>
  <p class="situation-note">이 표는 평상시 학습용입니다. 이 페이지는 실시간 경보를 송출하거나 경보 상태·해제 여부를 판정하지 않습니다. 공습·핵 경보가 같은 사이렌을 사용할 수 있다는 사실이 안전한 대피를 지연하는 근거가 되지 않습니다.</p>
 </section>
 <section class="readable" id="tsunami-alerts" aria-labelledby="tsunami-alerts-title">
  <h2 id="tsunami-alerts-title">해안 지진과 지진해일 재난문자는 이렇게 구분하세요</h2>
  <p><strong>해안에서 지진을 느꼈다면 문자나 특보를 기다리지 않고</strong> 해안과 하구에서 벗어나 높은 곳으로 이동합니다. 대피를 우선한 뒤 공식 안내를 확인하세요.</p>
  <ol>
   <li><strong>지진해일 주의보·경보:</strong> 기상청이 해안 지역에 발표하는 특보로, 해당 지역에 <strong>긴급재난문자</strong>가 전달됩니다. 해안 주민은 지정 긴급대피장소 또는 높은 지대로 대피하세요.</li>
   <li><strong>지진해일정보:</strong> 특보 기준보다 낮아도 영향이 예상될 때 발표하는 정보입니다. <strong>안전안내문자</strong>가 전달되며, 해안 접근을 피하고 최신 지역 안내와 위험 징후를 계속 확인하세요.</li>
   <li><strong>특보 해제:</strong> 기상청의 2026년 지진해일 특보 안내서에 따르면 해제 시 <strong>재난문자가 별도로 발송되지 않습니다.</strong> 문자가 추가로 오지 않는다는 이유로 안전을 추정하지 말고 공식 특보 현황과 현장 복귀 지시를 확인하세요.</li>
  </ol>
  <p>파도가 한 번 지나도 끝난 것으로 판단하지 마세요. 대피 후에는 해안으로 돌아가 사진을 촬영하거나 차량·어구를 확인하지 말고, 해제 확인 및 지자체 이동 안내를 따릅니다.</p>
  <p><a href={official.tsunami} target="_blank" rel="noopener noreferrer">국민안전24 지진해일 긴급대피 원문 ↗</a> · <a href={official.tsunamiNotice} target="_blank" rel="noopener noreferrer">기상청 2026년 지진해일 특보·재난문자 공식 설명 ↗</a></p>
  <p class="situation-note">이 페이지는 지진해일 특보의 실시간 발령·해제 상태를 표시하지 않습니다. 지역별 재난문자·기상청 발표·현장 지시를 우선하세요.</p>
 </section>
 <section class="readable" id="shelter-types" aria-labelledby="shelter-types-title">
  <h2 id="shelter-types-title">재난별로 대피 장소가 다릅니다</h2>
  <p>평소에 장소를 찾아둘 때는 국민안전24의 시설안전지도에서 <strong>재난 유형에 맞는 시설 종류</strong>를 먼저 선택하세요. 지도에 등록됐다는 사실만으로 모든 재난에 안전하거나 현재 개방 중이라는 뜻은 아닙니다.</p>
  <p class="table-scroll-note" id="shelter-table-help">모바일에서는 표를 좌우로 밀어 재난별 대피장소를 비교하세요.</p>
  <div class="comparison-scroll" role="region" aria-labelledby="shelter-types-title" aria-describedby="shelter-table-help" tabindex="0">
   <table>
    <caption>재난에 따른 대피 장소 선택 기준</caption>
   <thead><tr><th scope="col">상황</th><th scope="col">먼저 확인할 곳</th></tr></thead>
   <tbody>
    <tr><th scope="row">공습·민방공</th><td>민방위 대피소, 지하 시설 등 정부가 안내하는 장소. 침수 위험이 있는 지하공간은 피합니다.</td></tr>
    <tr><th scope="row">지진</th><td>낙하물 위험이 적은 지진 옥외대피장소. 흔들리는 동안에는 먼저 몸을 보호합니다.</td></tr>
    <tr><th scope="row">지진해일</th><td>해안에서 지진을 느끼면 특보·문자를 기다리지 않고 지진해일 긴급대피장소나 높은 곳으로 이동합니다. 시간이 부족하면 튼튼한 건물 3층 이상 또는 해발 10m 이상 언덕을 대안으로 고려하세요.</td></tr>
    <tr><th scope="row">핵 경보·방사능</th><td>경보가 먼저 발령되면 지하·콘크리트 건물 안쪽으로 신속히 대피합니다. 폭발이 이미 시작돼 대피할 시간이 없을 때는 엎드려 보호하고, 이후 낙진을 피해 실내에 머뭅니다.</td></tr>
    <tr><th scope="row">생물학 공격</th><td>외부 공기 유입을 줄일 수 있는 지정 대피시설·실내에 머물고, 불필요한 지역 간 이동을 피하며 보건당국 안내를 확인합니다.</td></tr>
    <tr><th scope="row">화학 공격</th><td>화생방경보·정부 방송에 따른 오염 차단과 대피. 공습 대피 방식과 무조건 동일하게 적용하지 않습니다.</td></tr>
    <tr><th scope="row">화학사고·유해물질 누출</th><td>실외 누출이면 안전한 실내로 이동해 외부 공기를 차단하고, 주민대피명령 시 지정 화학사고 대피장소로 이동합니다. 물질별 지시를 우선합니다.</td></tr>
    <tr><th scope="row">침수</th><td>반지하·지하주차장에 물이 들어오면 즉시 대피하며, 차량 이동을 위해 지하공간에 재진입하지 않습니다. 안전한 높은 장소와 지자체 지시를 따릅니다.</td></tr>
    <tr><th scope="row">산사태</th><td>산사태 진행 경로와 계곡부를 벗어나 지정 장소로 이동합니다. 급박할 때는 산사태 방향에서 먼 안전한 높은 곳을 선택합니다.</td></tr>
    <tr><th scope="row">산불</th><td>산불 진행 경로와 산에서 떨어진 지자체 안내 대피장소. 민방위 지하 대피소를 산불 대피소로 가정하지 않습니다.</td></tr>
   </tbody>
   </table>
  </div>
  <p><a href={official.shelter} target="_blank" rel="noopener noreferrer">국민안전24 공식 시설안전지도 ↗</a> · <a href="/plan/">가족별 대피장소·우회 경로 기록 →</a></p>
  <p class="situation-note">실제 상황에서 문자·방송·소방·지자체 대피 명령이 우선합니다. 사이트에서는 대피시설의 접근 가능 여부·수용 인원·현재 안전성을 판정하지 않습니다.</p>
 </section>
 <section class="readable" id="apartment-fire" aria-labelledby="apartment-fire-title">
  <h2 id="apartment-fire-title">아파트 화재는 우리 집에 불이 났는지부터 구분하세요</h2>
  <p>소방청·국민안전24의 <strong>아파트 입주자 화재 피난행동요령</strong>은 무조건 뛰어나가는 방식이 아닌 네 가지 상황별 대피·대기·구조 요청을 안내합니다. 가족에게 화재를 알리고 <strong>불이 난 위치, 우리 집으로 들어오는 연기·불꽃, 복도·계단의 상태</strong>를 살펴보세요.</p>
  <ol>
   <li><strong>우리 집에서 불이 났고 안전한 대피로가 있음:</strong> 지체 없이 계단으로 낮은 자세로 이동합니다. 출입문을 닫고 엘리베이터를 타지 않으며, 안전한 곳에서 119에 신고합니다.</li>
   <li><strong>우리 집 화재로 현관·출입구를 이용할 수 없음:</strong> 설치된 대피공간·경량칸막이·하향식피난구 등으로 이동합니다. 사용할 시설이 없다면 화염·연기에서 떨어진 공간에서 문을 닫고 틈을 막아 119에 구조를 요청합니다.</li>
   <li><strong>다른 세대·복도 등에서 불이 났지만 우리 집에 연기·불꽃이 없음:</strong> 무리하게 밖으로 나가지 않고 집 안에서 대기합니다. 창문을 닫고 화재 상황과 안내방송을 확인하며 119에 신고합니다. 공식 대피 지시가 있다면 현장 지시를 따릅니다.</li>
   <li><strong>다른 곳의 불이 우리 집까지 연기·불꽃으로 번짐:</strong> 복도·계단에 연기가 없어 안전한 대피로가 있으면 계단으로 대피합니다. 대피로가 위험하면 위의 피난시설 또는 실내 구조 요청 방법을 따릅니다.</li>
  </ol>
  <p><strong>평소 확인:</strong> 해당 아파트 세대에 대피공간·경량칸막이·하향식피난구가 실제 설치되어 있는지, 출입 가능하며 물건으로 막혀 있지 않은지 관리사무소와 확인하세요. 모든 아파트에 같은 피난시설이 있다고 가정하면 안 됩니다.</p>
  <p><a href={official.fire} target="_blank" rel="noopener noreferrer">국민안전24 ‘아파트(공동주택) 화재 발생 시’ 공식 행동요령 ↗</a> · <a href="/plan/">가족 비상계획에 피난시설 기록 →</a></p>
 </section>
 <section class="readable" id="biological-incident" aria-labelledby="biological-incident-title">
  <h2 id="biological-incident-title">생물학 공격이 의심되는 우편물·물질을 발견하면</h2>
  <p>정체를 알 수 없는 가루·분말이나 의심스러운 우편물은 <strong>열거나 털어 확인하지 말고 그대로 두세요.</strong> 직접 만지거나 청소하지 않고 다른 사람의 접근을 막은 뒤 안전한 장소에서 관계기관에 신고합니다. 소포·증상만으로 생물학 공격 여부를 판단하지 않습니다.</p>
  <p>지역에 화생방경보 또는 보건당국의 대응 지시가 내려진 경우 그 지시를 우선합니다. 감염 의심자에 대한 검사·격리·치료는 보건당국이 안내하며, 개인이 임의로 격리 범위나 약품을 결정하지 않습니다.</p>
  <p><strong>생물학 물질 신고·상담:</strong> <a href="tel:1339">질병관리청 1339</a> · 가까운 보건소. 화재·구조 등 즉각적인 위험은 <a href="tel:119">119</a>입니다.</p>
  <p><a href={official.biological} target="_blank" rel="noopener noreferrer">국민안전24 종합 행동요령 — ‘생물학 무기 공격 시 행동 요령’ 항목 ↗</a> · <a href={official.diseaseContact} target="_blank" rel="noopener noreferrer">질병관리청 1339 공식 안내 ↗</a> · <a href={official.civilAlarmLite} target="_blank" rel="noopener noreferrer">민방공 경보 경량 안내 ↗</a></p>
 </section>
 <section class="readable" id="contamination" aria-labelledby="contamination-title">
  <h2 id="contamination-title">화학·방사성 물질에 노출됐을 때</h2>
  <p><strong>화학물질 누출</strong>은 오염 현장 이탈 또는 실내 대기 중 적절한 행동을 사고 위치·물질·공식 지시로 판단합니다. <strong>방사성 낙진</strong>은 먼저 튼튼한 실내로 들어가 외부 노출을 줄이고, 안전한 실내에서 몸·의복에 묻은 오염물질을 제거합니다. 두 상황의 행동을 혼용하지 말고 현장 구조대·정부 지시를 따르세요.</p>
  <p class="situation-note"><strong>피폭과 오염은 다릅니다.</strong> 방사선에 노출되는 것(피폭)과 방사성 먼지 등이 피부·옷에 묻는 것(오염)은 같지 않습니다. 자가 제염은 몸에 묻은 방사성 물질의 제거를 돕는 조치이며, 이미 받은 외부 방사선 피폭을 되돌리지는 못합니다.</p>
  <h3>화학물질이 피부·옷에 묻은 경우</h3>
  <ol>
   <li>오염 구역에서 떨어진 안전한 곳에서 오염된 옷을 벗어 추가 접촉을 줄입니다. 옷은 밀폐할 수 있는 봉투·용기에 따로 보관합니다.</li>
   <li>화학무기 오염에 대한 국민안전24 안내는 <strong>흐르는 물로 15분 이상 세척 후 전문 치료</strong>입니다. 산업시설 화학물질은 종류에 따른 별도 조치가 필요할 수 있으므로 현장 구조·의료진 지시를 따르세요. 호흡곤란 등 급박한 증상이 있으면 119에 알립니다.</li>
   <li>건물에 대피 중이라면 문·창문을 닫고 외부 공기가 들어오는 환기·냉방기기를 멈춥니다. 오염 구역 재진입은 피하고 현장 지시를 따릅니다.</li>
  </ol>
  <p><a href={official.chemical} target="_blank" rel="noopener noreferrer">국민안전24 화학무기 공격 행동요령 ↗</a></p>
  <h3>방사성 낙진이 옷·몸에 묻은 것으로 의심되는 경우</h3>
  <ol>
   <li>가까운 안전한 건물 안으로 들어가 외부 공기·먼지의 유입을 줄입니다. 가능하면 외부 벽·지붕에서 먼 내부 공간에서 <strong>겉옷을 조심히 벗고</strong> 밀폐 가능한 봉투에 담아 사람·반려동물과 떨어뜨려 둡니다. 옷을 세게 털어 먼지를 날리지 마세요.</li>
   <li>안전한 실내에서 샤워할 수 있다면 <strong>미온수와 비누·샴푸로 부드럽게 씻고</strong> 깨끗한 옷으로 갈아입습니다. 피부를 거칠게 문지르거나 긁지 마세요. 머리를 감을 때는 <strong>린스를 사용하지 마세요.</strong> 샤워할 수 없다면 젖은 수건이나 물티슈로 손·얼굴·노출된 피부를 부드럽게 닦습니다.</li>
   <li>씻기 위해 안전한 대피공간을 나와 다시 오염된 외부로 이동하지 않습니다. 오염 의심 식수·식품의 섭취 여부와 이동·검사·진료는 보건·방재 당국의 안내에 따릅니다. 갑상샘방호약품(요오드화칼륨)은 관계 당국이 복용을 지시하지 않는 한 임의로 먹지 마세요.</li>
  </ol>
  <p><a href={official.nuclear} target="_blank" rel="noopener noreferrer">국민안전24 종합 행동요령 — ‘핵 경보 발령 시 행동 요령’ 항목 ↗</a> · <a href={official.radiationDecon} target="_blank" rel="noopener noreferrer">CDC 샤워가 어려울 때 자가 제염 안내(해외 참고) ↗</a> · <a href={official.radiationFAQ} target="_blank" rel="noopener noreferrer">CDC 방사능 노출·방호약품 FAQ(해외 참고) ↗</a></p>
  <p class="situation-note">화학무기 안내의 세척 시간은 모든 산업용 화학물질에 동일하게 적용되는 규칙이 아닙니다. 물질별 특별 지시가 있으면 이를 우선하세요. 자가 제염은 전문 구조·의료 조치를 대신하지 않습니다. 물을 사용할 수 없거나 중증 증상이 있다면 119 및 현장 구조기관의 안내를 우선합니다. 소독약·표백제 등 화학약품을 임의로 몸에 바르지 마세요.</p>
 </section>
 <section class="readable" id="facilities-lookup" aria-labelledby="facilities-lookup-title">
  <h2 id="facilities-lookup-title">민방위 대피시설·비상급수시설 찾기</h2>
  <p>평소에 <strong>국민안전24 시설안전지도</strong>를 열어 대피시설 항목의 <strong>민방위 대피소</strong>를 선택하고, 집·직장·학교 주변 후보를 확인하세요. 실제 출입구·접근 경로를 확인하고 침수 위험 등도 고려해야 합니다.</p>
  <p>수도 공급 중단에 대비한 <strong>비상급수시설</strong>은 지도에서 별도의 항목으로 선택해 확인합니다. 대피시설과 급수시설은 동일하지 않으며, 표시된 위치가 현재 운영·급수 중임을 보장하지 않습니다. 재난 발생 후에는 <strong>관할 지자체·수도사업자의 실제 급수 안내</strong>가 우선입니다.</p>
  <p><strong>지도 접속이 어려우면:</strong> 대피시설 또는 급수시설 경량 조회 페이지를 열고 <strong>시·도 및 시·군·구 등 조회 지역을 먼저 선택한 뒤 검색</strong>하세요. 최초 화면의 ‘전체 0건’ 표시는 아직 지역을 검색하지 않은 상태일 수 있어 대피시설이 없다는 뜻으로 해석하면 안 됩니다. 검색 후 결과도 실시간 개방·급수 가능 여부를 보증하지 않습니다.</p>
  <p><a href={official.shelter} target="_blank" rel="noopener noreferrer">공식 시설안전지도 ↗</a> · <a href={official.shelterBackup} target="_blank" rel="noopener noreferrer">대피시설 경량 조회 ↗</a> · <a href={official.waterFacility} target="_blank" rel="noopener noreferrer">급수시설 경량 조회 ↗</a></p>
  <p>해안 지역의 <strong>지진해일 긴급대피장소</strong>는 민방위 지하 대피시설과 구분해야 합니다. 같은 지도상 장소라도 재난별로 적절한지 확인하세요.</p>
  <p><a href="/plan/">집·직장 주변 시설을 가족 비상계획 카드에 기록하기 →</a></p>
 </section>
 <section class="readable" id="lifeline-response" aria-labelledby="lifeline-response-title">
  <h2 id="lifeline-response-title">정전·단수·침수가 함께 발생하면</h2>
  <ol>
   <li><strong>물이 차는 공간에서는 대피가 먼저입니다.</strong> 전기·수도 복구를 확인하러 침수된 지하실·주차장으로 내려가지 마세요.</li>
   <li><strong>정전과 승강기 갇힘은 구분합니다.</strong> 일반 정전 신고는 한국전력 <a href="tel:123">123</a>, 승강기 구조·화재·응급상황은 <a href="tel:119">119</a>입니다.</li>
   <li><strong>단수는 지역별 공지를 확인합니다.</strong> 수도 공급이 돌아와도 탁수나 오염 경고가 남아 있으면 지자체 수질 안내에 따라 식수 사용을 판단하세요.</li>
  </ol>
  <p><a href={official.flood} target="_blank" rel="noopener noreferrer">침수 공식 행동요령 ↗</a> · <a href={official.power} target="_blank" rel="noopener noreferrer">정전·승강기 대응 원문 ↗</a> · <a href="/plan/">가족 비상계획에 연락처 기록 →</a></p>
 </section>
 <section class="last-call"><strong>긴급 신고</strong><p>화재·구조·구급은 <a href="tel:119">119</a>, 치안 긴급신고는 <a href="tel:112">112</a>, 감염병·생물학적 오염 의심 상담은 <a href="tel:1339">질병관리청 1339</a> 또는 관할 보건소를 이용합니다. 즉각적인 위험에서 먼저 안전을 확보한 후 위치와 상황을 알리세요.</p></section>
