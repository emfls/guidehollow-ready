---
import { affiliateOffers, affiliatePhoto, type AffiliateOfferKey } from '../data/affiliate-product-visuals';
interface Props {
 offer:AffiliateOfferKey;
 title:string;
 note:string;
 buttonText?:string;
 checkId?:string;
}
const {offer,title,note,buttonText='쿠팡에서 상품 확인하기 ↗',checkId}=Astro.props;
const item=affiliateOffers[offer];
const image=affiliatePhoto(offer);
---
<article class="ready-shop-card" data-affiliate-offer={offer} data-offer-check-id={checkId}>
 <div class="ready-shop-image">
  {image ? <img src={image} width="120" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt={item.alt+' 쿠팡파트너스 상품 배너'}/> : <span role="img" aria-label={item.alt+' 사진 미등록'}>{item.emoji}</span>}
 </div>
 <div class="ready-shop-body">
  <span class="ready-shop-chip">쿠팡파트너스 등록 상품</span>
  <h3>{title}</h3>
  {checkId && <small class="ready-shop-checkstatus" data-offer-check-status>상세 체크 기록 확인 중</small>}
  <p>{note}</p>
  <a href={item.url} class="partner-check-action" target="_blank" rel="sponsored nofollow noopener noreferrer">{buttonText}</a>
 </div>
</article>
