---
import Base from '../layouts/Base.astro';

const official = {
 emergency: 'https://safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EB%B9%84%EC%83%81%EC%82%AC%ED%83%9C&category=stateOfEmergency&menuSn=4',
 alarms: 'https://www.mois.go.kr/frt/sub/a06/b12/civildefensework/screen.do',
 shelter: 'https://www.safekorea.go.kr/safekorea-kor/flsm/flsm/facilitiesSafteyMap.do',
 shelterBackup: 'https://www.safekorea.go.kr/safekorea-kor/em/shelter/emergency_df2.html',
 waterFacility: 'https://www.safekorea.go.kr/safekorea-kor/em/shelter/emergency_df3.html',
 earthquake: 'https://www.weather.go.kr/w/wnuri-eqk-vol/eqk/warning.do',
 fire: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%ED%99%94%EC%9E%AC&category=fires&menuSn=4',
 flood: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EC%B9%A8%EC%88%98&category=inundation&menuSn=4',
 power: 'https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%EC%A0%95%EC%A0%84+%EB%B0%8F+%EC%A0%84%EB%A0%A5%EB%B6%80%EC%A1%B1&category=powerOutagesandShortages&menuSn=4',
 water: 'https://safecity.seoul.go.kr/bhvr/livesafe/bhvrLivesafeSingularList.page?menuId=MENU_SSNS_000103',
} as const;

const situations = [
 {id:'warning',name:'경계경보',time:'공격이 예상될 때',points:['방송·재난문자로 경보 종류와 지역, 대피 지시를 확인합니다.','가까운 민방위 대피시설과 이동 경로를 점검하고, 어린이·노약자는 안내에 따라 미리 대피를 준비합니다.','비상물품을 준비하고 주변 사람에게 경보 내용을 알립니다.'],why:'경계경보와 공습경보의 행동은 다릅니다. 정부의 대피 지시가 있으면 준비보다 대피가 우선입니다.',href:official.emergency},
 {id:'air-raid',name:'공습경보·포격',time:'공격이 임박하거나 진행될 때',points:['가까운 민방위 대피시설, 지하철역·지하시설 또는 콘크리트 건물 안쪽의 창문 없는 곳으로 신속히 대피합니다.','고층 건물에서는 엘리베이터 대신 계단을 이용합니다. 운전 중이라면 안전한 곳에 정차한 뒤 대피합니다.','대피한 뒤에는 정부 안내방송을 계속 확인하고 현장 관리자의 지시를 따릅니다.'],why:'호우·침수 위험이 있는 저지대 지하공간은 피하고, 지역 상황에 맞는 안전한 곳을 선택해야 합니다. 모든 지하공간이 공식 지정 대피소는 아닙니다.',href:official.emergency},
 {id:'chemical',name:'화학 공격·화생방경보',time:'화학물질 오염이 확인되거나 우려될 때',points:['경보 내용을 확인하고 오염 지역과 외부 공기의 유입을 피합니다. 화학 공격 시에는 외부 공기를 차단할 수 있는 높은 층의 실내 공간이 안내됩니다.','실내에서는 창문·출입문을 닫고 외부 공기를 들여오는 환기·냉방기기 등을 멈춥니다.','공습 때문에 지하에 대피 중이라도 화학 공격이 확인되면 동일한 지하 대피가 적절하지 않을 수 있으므로 정부·현장 지시에 따라 비오염 구역으로 이동합니다.'],why:'일반 마스크나 젖은 수건은 화학작용제 전용 방독면과 같은 보호 성능이 아닙니다. 무작정 지하로 이동하지 마세요.',href:official.emergency},
 {id:'biological',name:'생물학 공격 의심',time:'오염 또는 집단 감염 관련 안내가 있을 때',points:['오염이 의심되는 물질·장소·환자와의 접촉을 피하고 호흡기를 보호합니다.','정부·지자체에서 정한 장소 또는 실내로 이동하고, 임의의 장거리 이동으로 확산 위험을 높이지 않습니다.','위생을 유지하고 보건당국의 검사·치료·예방접종 지시를 따릅니다.'],why:'증상만으로 공격 여부를 판단하거나 임의로 치료하지 마세요. 보건당국의 공식 발표가 우선입니다.',href:official.emergency},
 {id:'nuclear',name:'핵 경보·방사능 낙진',time:'핵 공격 경보 또는 방사능 위험 안내 시',points:['신속히 민방위 대피시설, 지하철역 등 지하시설이나 콘크리트 건물의 창문 없는 안쪽으로 대피합니다.','폭발 순간 대피할 여유가 없다면 지형·지물을 이용해 엎드려 눈과 귀를 가리고 입을 벌려 몸을 보호합니다.','폭풍과 낙하물이 멈춘 뒤에는 낙진 노출을 줄일 수 있는 실내 깊은 곳에 머물며 정부의 이동·제염 안내를 기다립니다.'],why:'핵·방사능 대피는 화학물질 대피와 다릅니다. 특정 건물이 안전하다고 보증하거나 독자적인 대피 종료 시점을 제시하지 않습니다.',href:official.emergency},
 {id:'earthquake',name:'지진',time:'지면이 흔들릴 때',points:['흔들리는 동안 튼튼한 탁자 아래 등에서 머리와 몸을 보호합니다.','흔들림이 멈추면 계단으로 이동하고, 건물 밖에서는 건물·간판·유리창과 거리를 둡니다.','운동장·공원 등 낙하물 위험이 적은 넓은 장소에서 여진과 공식 안내를 확인합니다.'],why:'지진 대피장소는 민방위 지하 대피시설과 용도가 다를 수 있습니다.',href:official.earthquake},
 {id:'fire',name:'화재·연기',time:'불이나 연기를 발견할 때',points:['주변에 알리고 대피가 가능한 안전한 경로를 먼저 확인합니다.','복도·계단에 연기가 없다면 계단으로 낮은 자세로 대피하고, 문을 닫으며 엘리베이터는 사용하지 않습니다.','대피로에 화염·연기가 있다면 무리하게 통과하지 말고 안전한 실내·피난공간에서 문틈을 막고 119에 위치를 알립니다.'],why:'아파트의 다른 세대 화재 등에서는 무조건 밖으로 나가는 행동이 오히려 위험할 수 있습니다.',href:official.fire},
 {id:'flood',name:'집중호우·침수',time:'물이 차오르거나 대피 지시가 있을 때',points:['침수가 시작된 지하차도·지하공간에 진입하지 않고 하천·급류에서 멀어집니다.','대피 안내가 내려오면 침수 위험이 없는 높은 장소 등 지정된 안전 지역으로 이동합니다.','침수된 전기설비와 물에 잠긴 도로는 접근하지 않습니다.'],why:'침수 위험이 있을 때는 공습 시 이용하던 저지대 지하시설도 안전하지 않을 수 있습니다.',href:official.flood},
 {id:'power',name:'정전',time:'전기 공급이 멈출 때',points:['손전등·배터리 라디오를 사용하고, 정전 범위 및 관리사무소·한국전력 등의 안내를 확인합니다.','승강기에 갇혔다면 비상통화장치로 구조를 요청하고 문을 강제로 열어 탈출하지 않습니다.','안내에 따라 전기기기의 사용을 줄이고, 복구 뒤에는 안전을 확인하며 사용합니다.'],why:'실내에서 발전기나 숯·연소기구를 사용하지 마세요. 일산화탄소 중독과 화재 위험이 있습니다.',href:official.power},
 {id:'water',name:'단수',time:'수돗물 공급이 멈출 때',points:['가정의 보관 식수·위생용 물을 아껴 쓰고, 오염이 의심되는 물은 마시지 않습니다.','지자체·관할 수도사업자의 단수 범위와 복구·비상급수 안내를 확인합니다. 평소에는 국민안전24에서 비상급수시설 위치를 따로 조회할 수 있습니다.','급수 재개 시 음용 가능 여부나 수질 관련 별도 안내가 있다면 이를 따릅니다.'],why:'단수·복구 시점과 급수 방법은 지역마다 다릅니다. 특정 위치의 비상급수 가능 여부를 이 사이트에서 보증하지 않습니다.',href:official.water}
] as const;
---
<Base title="재난 상황별 행동요령" description="공습·민방공 경보와 화학·핵·지진·화재·침수 등 상황별 핵심 행동을 한국 공식 지침에 따라 안내합니다.">
<div class="container">
 <header class="page-intro"><span class="eyebrow">IN AN EMERGENCY</span><h1>경보 종류부터 확인하고<br/><em>상황에 맞게 대피하세요</em></h1><p>미리 읽어두는 행동요령입니다. 현재 경보를 표시하는 페이지가 아니며, 실제 상황에서는 재난문자·공공방송·현장 지시를 우선합니다.</p></header>
 <div class="emergency-panel"><div><span class="tag">가장 먼저</span><strong>공습은 지하 대피, 화학 공격은 외부공기 차단 등 대피 방법이 다릅니다</strong><p>경보 이름·해당 지역·대피 지시를 확인하세요. 침수 위험이 있는 지하공간으로 무조건 내려가지 마세요.</p></div><a class="btn primary" href={official.emergency} target="_blank" rel="noopener noreferrer">국민안전24 행동요령 ↗</a></div>
 <nav class="readable" aria-label="상황별 행동요령 바로가기"><p><strong>바로 이동:</strong> {situations.map((item,i)=><> <a href={'#'+item.id}>{item.name}</a>{i<situations.length-1?' · ':''}</>)}</p></nav>
 <div class="situation-list">
 {situations.map((item,i)=><section class="situation-card" id={item.id} aria-labelledby={item.id+'-title'}>
  <div class="situation-heading"><span>{String(i+1).padStart(2,'0')}</span><div><small>{item.time}</small><h2 id={item.id+'-title'}>{item.name}</h2></div></div>
  <ol>{item.points.map(p=><li>{p}</li>)}</ol>
  <p class="situation-note">{item.why}</p>
  <a href={item.href} target="_blank" rel="noopener noreferrer" class="text-link">이 상황의 공식 안내 확인 ↗</a>
 </section>)}
 </div>
 <section class="readable">
  <h2>민방위 대피시설·비상급수시설 찾기</h2>
  <p>평소에 <strong>국민안전24 시설안전지도</strong>를 열어 대피시설 항목의 <strong>민방위 대피소</strong>를 선택하고, 집·직장·학교 주변 후보를 확인하세요. 실제 출입구·접근 경로를 확인하고 침수 위험 등도 고려해야 합니다.</p>
  <p>수도 공급 중단에 대비한 <strong>비상급수시설</strong>은 지도에서 별도의 항목으로 선택해 확인합니다. 대피시설과 급수시설은 동일하지 않으며, 표시된 위치가 현재 운영·급수 중임을 보장하지 않습니다.</p>
  <p><a href={official.shelter} target="_blank" rel="noopener noreferrer">공식 시설안전지도 ↗</a> · <a href={official.shelterBackup} target="_blank" rel="noopener noreferrer">대피시설 경량 조회 ↗</a> · <a href={official.waterFacility} target="_blank" rel="noopener noreferrer">급수시설 경량 조회 ↗</a></p>
  <p><a href="/plan/">집·직장 주변 시설을 가족 비상계획 카드에 기록하기 →</a></p>
 </section>
 <section class="last-call"><strong>긴급 신고</strong><p>화재·구조·구급은 <a href="tel:119">119</a>, 치안 긴급신고는 <a href="tel:112">112</a>. 가능한 안전한 곳에서 신고하고 현재 위치와 위험 상황을 알리세요.</p></section>
 <p class="source-caption">공식 자료 대조일: <time datetime="2026-10-28">2026년 10월 28일</time> · 출처: 행정안전부 민방위 제도 운영, 국민안전24 비상시 행동요령·화재·침수·정전, 기상청 지진 안내. <a href="/sources/">공식 출처 전체 보기 →</a></p>
</div>
</Base>
