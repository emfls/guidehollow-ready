---
import Base from '../layouts/Base.astro';
import { sources } from '../data/resources';
const quickLinks=[
 {icon:'◉',label:'대피 행동요령',description:'경보 종류에 맞는 첫 행동',href:'/situations/',meta:'긴급 대처'},
 {icon:'☑',label:'준비물 체크리스트',description:'집에 있는 준비물부터 점검',href:'/checklist/',meta:'기본 22항목'},
 {icon:'⌂',label:'가족 연락 계획',description:'연락 두절 시 집결·대체 계획',href:'/plan/',meta:'인쇄용 카드'},
 {icon:'▣',label:'비상 준비 장바구니',description:'물·식량·조명 6가지 한번에 점검',href:'/starter-kit/',meta:'부족한 것만 준비'},
] as const;
const situationLinks=[
 {icon:'▣',label:'공습경보',description:'가까운 안전한 대피시설로 이동',href:'/situations/#air-raid',warning:true},
 {icon:'◈',label:'화학 공격',description:'외부 공기 유입 차단과 당국 안내',href:'/situations/#chemical',warning:true},
 {icon:'◉',label:'핵·방사능',description:'튼튼한 건물 안쪽이나 지하 대피',href:'/situations/#nuclear',warning:true},
 {icon:'⌁',label:'정전',description:'조명 확보·승강기 갇힘 신고',href:'/situations/#power',warning:false},
 {icon:'◫',label:'단수',description:'안전한 식수와 지자체 급수 안내',href:'/situations/#water',warning:false},
 {icon:'△',label:'화재',description:'연기 피하기·안전 경로 확인',href:'/situations/#fire',warning:true},
 {icon:'≈',label:'집중호우·침수',description:'지하공간·침수도로 접근 금지',href:'/situations/#flood',warning:true},
 {icon:'◇',label:'지진',description:'흔들리는 동안 머리·몸 보호',href:'/situations/#earthquake',warning:false},
] as const;

---
<Base title="전시·재난 대비, 오늘부터 할 수 있는 준비">
 <div class="container">
 <section class="hero brief-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
   <span class="eyebrow">전시·재난 대비 생활 안내</span>
   <h1 id="hero-title">전시·재난 대비, <em>필요한 준비부터.</em></h1>
   <p class="lead"><strong>대피 방법·가족 연락·비상물품</strong>을 평상시 미리 확인하세요. 실제 상황은 정부 경보와 현장 지시가 우선입니다.</p>
   <div class="hero-actions"><a class="btn primary" href="#situation-hub">상황별 첫 행동 찾기 →</a><a class="btn secondary" href="/checklist/">우리 집 준비 점검</a></div>
   <p class="brief-meta">비공식 민간 정보 사이트 · 실시간 경보 제공 안 함</p>
  </div>
  <aside class="brief-box" aria-label="사이트 이용 순서">
   <span>QUICK BRIEF</span><h2>확인 → 계획 → 준비</h2>
   <p>평상시에는 먼저 대피소를 확인하고 가족 연락 계획과 물품을 준비하세요.</p>
   <a href={sources.government} target="_blank" rel="noopener noreferrer">국민안전24 공식 안내 ↗</a>
  </aside>
 </section>
 <section class="urgent-links" aria-label="긴급시 공식 안내">
  <div><span class="urgent-icon" aria-hidden="true">!</span><div><strong>실제 경보·재난 발생 시</strong><p>여기에는 실시간 경보가 표시되지 않습니다. 공식 재난문자와 당국 안내를 우선하세요.</p></div></div>
  <a href={sources.government} target="_blank" rel="noopener noreferrer">공식 재난정보 확인 <span aria-hidden="true">↗</span></a>
 </section>
 <section class="section dashboard-section" aria-labelledby="quick-title">
  <div class="section-head"><span class="section-label">QUICK ACCESS</span><h2 id="quick-title">필요한 정보, 바로 찾기</h2><p>원하는 항목을 눌러 바로 이동하세요.</p></div>
  <div class="quick-grid">{quickLinks.map(item=><a href={item.href} class="brief-card">
   <span class="brief-card-icon" aria-hidden="true">{item.icon}</span>
   <small>{item.meta}</small><h3>{item.label}</h3><p>{item.description}</p>
   <span class="brief-card-action">바로 확인 ↗</span>
  </a>)}</div>
 </section>
 <section class="section dashboard-section" id="situation-hub" aria-labelledby="situations-title">
  <div class="section-head"><span class="section-label">ACTION BY SITUATION</span><h2 id="situations-title">상황별 첫 행동</h2><p>카드를 선택하면 해당 상황의 자세한 행동요령으로 바로 이동합니다.</p></div>
 
  <div class="situation-hub-grid">{situationLinks.map(item=><a class:list={['situation-hub-card',{'situation-hub-card--urgent':item.warning}]} href={item.href}>
   <span class="situation-hub-icon" aria-hidden="true">{item.icon}</span><h3>{item.label}</h3><p>{item.description}</p>
   <span>상세 행동요령 ↗</span>
  </a>)}</div>
  <p class="hub-caution">경보 종류·지역·침수·오염 여부에 따라 대피 방법이 달라집니다. 위 내용은 사전 학습용 요약이며 실제 상황에서는 공식 지시를 우선하세요.</p>
 </section>
 <a class="home-kit-banner" href="/starter-kit/"><span class="home-kit-symbol" aria-hidden="true">▣</span><div><strong>비상 준비물, 6가지부터 확인하기</strong><p>집에 있는 물품은 체크하고 부족한 것만 준비하세요.</p></div><span class="home-kit-arrow" aria-hidden="true">→</span></a>
 <section class="section" aria-labelledby="buying">
  <div class="section-head"><span class="section-label">BUY ONLY WHAT YOU NEED</span><h2 id="buying">비상물품, 어떻게 고를까요?</h2><p>구매 전에 필요한 것만 간단히 확인하세요.</p></div>
  <div class="split-cards">
   <a class="split-card" href="/buying/food/"><span class="tag">비상식량</span><h3>비상식량·식수 준비</h3><p>물과 전기가 없어도 먹을 수 있는지 살펴봐요.</p><span>식량 선택 기준 보기 →</span></a>
   <a class="split-card" href="/buying/gear/"><span class="tag">비상용품</span><h3>손전등·전원·구급용품</h3><p>실제로 사용할 수 있는 제품을 고르는 기준.</p><span>용품 선택 기준 보기 →</span></a>
  </div>
 </section>
 </div>
</Base>
