---
import Base from '../layouts/Base.astro';
import { sources,checkGroups } from '../data/resources';
const basicItemIds=checkGroups.filter(g=>!('audience' in g)).flatMap(g=>g.items.map(item=>item.id));
const quickLinks=[
 {icon:'☑',label:'준비물 체크리스트',description:'집에 있는 준비물부터 표시하고 남은 항목 확인',href:'/checklist/',meta:'기본 22개',progress:true},
 {icon:'⌂',label:'가족 연락 계획',description:'연락 두절 시 만날 장소와 연락 방법 미리 정하기',href:'/plan/',meta:'우리 가족',progress:false},
 {icon:'◇',label:'3분 행동 연습',description:'공습·화학·지진 대응을 평소에 짧게 연습',href:'/drill/',meta:'사전 훈련',progress:false},
] as const;
const situationLinks=[
 {icon:'⌁',label:'정전',description:'조명과 통신 수단 확인',href:'/situations/#power'},
 {icon:'△',label:'화재',description:'연기·대피 경로 확인',href:'/situations/#fire'},
 {icon:'≈',label:'침수',description:'지하·침수도로 접근 금지',href:'/situations/#flood'},
 {icon:'◇',label:'지진',description:'흔들림 중 몸 보호',href:'/situations/#earthquake'},
] as const;

---
<Base title="전시·재난 대비, 오늘부터 할 수 있는 준비">
 <div class="container">
 <section class="emergency-home-action" aria-labelledby="emergency-home-title" id="right-now">
  <div class="emergency-home-heading">
    <div><span class="emergency-home-label">지금 위험한 상황이라면</span><h2 id="emergency-home-title">지금 위험한가요? 먼저 안전을 확보하세요</h2>
    <p>여기는 실시간 경보 화면이 아닙니다. 아래는 사전 작성된 요약이며 <strong>실제 재난문자·방송·현장 지시가 우선</strong>입니다.</p></div>
    <a class="emergency-home-all" href="/emergency/">상황별 즉시 행동 보기 →</a>
  </div>
  <div class="emergency-home-three">
    <a href="/emergency/#air-raid" class="emergency-home-card"><span>공습·포격</span><strong>튼튼한 건물 안쪽이나 안전한 대피시설로 피하세요</strong><small>대피 장소 확인 →</small></a>
    <a href="/emergency/#chemical" class="emergency-home-card"><span>화학 공격</span><strong>경보를 확인하고 외부 공기 유입을 차단하세요</strong><small>실내 대기 기준 →</small></a>
    <a href="/emergency/#nuclear" class="emergency-home-card"><span>핵·낙진</span><strong>지하 또는 두꺼운 건물 중앙으로 대피하세요</strong><small>폭발·낙진 대응 →</small></a>
  </div>
  <div class="emergency-home-links">
    <a class="emergency-shelter-link" href="https://www.safekorea.go.kr/safekorea-kor/flsm/flsm/facilitiesSafteyMap.do" target="_blank" rel="noopener noreferrer"><strong>공식 민방위 대피소 찾기 ↗</strong><small>국민안전24 시설안전지도 · 지역 선택 필요</small></a>
    <a class="emergency-save-link" href="/offline/ready-card.html" download="가족_재난_행동카드.html"><strong>인터넷 없이 볼 행동카드 저장 ↓</strong><small>미리 내려받아 열거나 PDF로 인쇄하세요</small></a>
  </div>
</section>
<section class="home-routine-heading" aria-label="평상시 준비 안내"><span>평상시 준비하기</span><p>경보 상황이 아니라면 아래에서 우리 집 준비를 시작하세요.</p></section>
<section class="hero brief-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
   <span class="eyebrow">평상시 대비</span>
   <h1 id="hero-title">전시·재난 대비, <em>필요한 준비부터.</em></h1>
   <p class="lead">오늘 할 일은 세 가지입니다. <strong>준비물 확인, 가족 연락 계획, 대응 연습.</strong> 실제 위험 상황에서는 위의 긴급 행동을 먼저 확인하세요.</p>
   <p class="brief-meta">정보 확인일: 2026년 10월 28일 · 정부 경보와 현장 지시가 우선</p>
  </div>
 </section>
  <section class="section dashboard-section" aria-labelledby="quick-title">
  <div class="section-head"><span class="section-label">첫 단계</span><h2 id="quick-title">우리 집 준비, 여기서 시작</h2><p>아래 세 가지 중 지금 필요한 것 하나만 선택하세요.</p></div>
  <div class="quick-grid">{quickLinks.map(item=><a href={item.href} class="brief-card">
   <span class="brief-card-icon" aria-hidden="true">{item.icon}</span>
   <small>{item.meta}</small><h3>{item.label}</h3><p>{item.description}</p>
   {item.progress && <span class="home-checklist-progress" data-check-ids={JSON.stringify(basicItemIds)}><span id="home-checked-count">—</span> / {basicItemIds.length}개 확인 <span class="home-checklist-meter"><span id="home-checklist-meter-fill"></span></span></span>}
   <span class="brief-card-action">바로 확인 →</span>
  </a>)}</div>
 </section>
 <section class="section dashboard-section" id="situation-hub" aria-labelledby="situations-title">
  <div class="section-head"><span class="section-label">다른 상황도 미리 보기</span><h2 id="situations-title">어떤 상황인가요?</h2><p>공습·화학·핵 대응은 맨 위 긴급 행동에서 확인할 수 있습니다.</p></div>
  <div class="situation-hub-grid">{situationLinks.map(item=><a class="situation-hub-card" href={item.href}>
   <span class="situation-hub-icon" aria-hidden="true">{item.icon}</span><h3>{item.label}</h3><p>{item.description}</p>
   <span>행동요령 보기 →</span>
  </a>)}</div>
  <a class="home-other-alerts" href="/situations/">단수·산불·지진해일 등 모든 재난 행동요령 보기 →</a>
  <p class="hub-caution">실제 경보가 발생했다면 유형·지역에 맞는 정부·현장 지시를 먼저 확인하세요. 위 카드는 사전 안내입니다.</p>
 </section>
 <a class="home-protocol-banner" href="/protocols/"><span aria-hidden="true">▦</span><div><strong>3일·7일·14일·30일·60일·90일 준비 프로토콜</strong><p>기간별 준비물과 가족별 식수량, 확인된 쿠팡 상품을 한눈에 비교</p></div><span aria-hidden="true">→</span></a>
 <a class="home-kit-banner" href="/starter-kit/#starter-personal"><span class="home-kit-symbol" aria-hidden="true">▣</span><div><strong>우리 집 준비물 6가지 점검하기</strong><p>식수 필요량 계산부터 확인할 물품 정리까지 한 번에</p></div><span class="home-kit-arrow" aria-hidden="true">→</span></a>
 <nav class="home-resource-links" aria-label="비상용품 구매 전 안내">
  <a href="/buying/food/">식수·비상식량 선택 기준 <span aria-hidden="true">→</span></a>
  <a href="/reviews/">제조사 사양 기반 제품 비교 <span aria-hidden="true">→</span></a>
 </nav>
 <p class="home-resource-note">이미 갖춘 물건이 있다면 먼저 수량과 작동 상태를 확인하세요. 준비물 구매보다 안전한 대피와 가족 연락 계획이 우선입니다.</p>
 </div>
<script>
const summary=document.querySelector<HTMLElement>('.home-checklist-progress');
const current=document.querySelector<HTMLElement>('#home-checked-count');
const fill=document.querySelector<HTMLElement>('#home-checklist-meter-fill');
if(summary&&current&&fill){
 try{
  const known:unknown=JSON.parse(summary.dataset.checkIds||'[]');
  const record=localStorage.getItem('guidehollow-ready-check-v1');
  const selected:unknown=record===null?[]:JSON.parse(record);
  if(!Array.isArray(known)||!known.every(x=>typeof x==='string')||!Array.isArray(selected)||!selected.every(x=>typeof x==='string')||new Set(selected).size!==selected.length)throw Error('Invalid saved checklist');
  const valid=new Set(known as string[]);
  const done=selected.filter((x:string)=>valid.has(x)).length;
  current.textContent=String(done);
  fill.style.width=(known.length?done/known.length*100:0)+'%';
 }catch{
  current.textContent='—';
  fill.style.width='0%';
  summary.setAttribute('aria-label','저장된 진행 상태를 읽을 수 없습니다. 체크리스트에서 상태를 확인하세요.');
 }
}
</script>
</Base>
