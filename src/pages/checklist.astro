.check-damaged-group button{background:#23434b;border:1px solid #b6d1c8;border-radius:9px;min-height:44px;padding:9px 12px;margin:0 8px 8px 0;color:#f6fff9;font-weight:750;cursor:pointer}
.check-damaged-group button:focus-visible{outline:3px solid #fff;outline-offset:2px}
