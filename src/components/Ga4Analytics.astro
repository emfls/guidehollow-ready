---
/**
 * Affiliate click instrumentation and unobtrusive opt-out control.
 * The standard Google tag is rendered once in the global <head> by Base.astro.
 * No automatic popup, modal, or consent prompt is shown.
 */
const ga4Id=(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID??'').trim();
const enabled=/^G-[A-Z0-9]{6,}$/.test(ga4Id);
---
{enabled && <script is:inline>
(() => {
 'use strict';
 const settings=document.getElementById('ga4-settings');
 const key='guidehollow-ready-ga4-setting-v2';
 const isDisabled=()=>Boolean(window.__guidehollowGa4Disabled);
 const updateLabel=()=>{
  if(!settings)return;
  settings.textContent=isDisabled()?'방문 통계 켜기':'방문 통계 끄기';
  settings.setAttribute('aria-label',isDisabled()?'GA4 방문 통계 다시 켜기':'GA4 방문 통계 수집 끄기');
 };
 updateLabel();
 settings?.addEventListener('click',()=>{
  const next=isDisabled()?'on':'off';
  try{localStorage.setItem(key,next);}catch{}
  if(next==='off'){
   // Deny future analytics events, even before the new document loads.
   if(typeof window.gtag==='function')window.gtag('consent','update',{
    analytics_storage:'denied',ad_storage:'denied',
    ad_user_data:'denied',ad_personalization:'denied'
   });
   const names=document.cookie.split(';').map(x=>x.trim().split('=')[0]).filter(x=>/^_ga(?:_|$)/.test(x));
   const domains=['',location.hostname,'guidehollow.com'];
   for(const name of names)for(const domain of domains){
    document.cookie=encodeURIComponent(name)+'=; Max-Age=0; Path=/; SameSite=Lax'+(domain?'; Domain='+domain:'');
   }
  }
  location.reload();
 });
 // Records outbound clicking only, never order completion or partner commissions.
 document.addEventListener('click',event=>{
  if(isDisabled()||typeof window.gtag!=='function')return;
  const element=event.target;
  if(!(element instanceof Element))return;
  const anchor=element.closest('a[href^="https://link.coupang.com/a/"]');
  if(!anchor)return;
  const raw=anchor.getAttribute('href')||'';
  const match=raw.match(/^https:\/\/link\.coupang\.com\/a\/([A-Za-z0-9]{6,20})(?:[?#].*)?$/);
  if(!match)return;
  const placement=anchor.closest('.review-related-buying')?'review_related':
   anchor.closest('.shop-guide-item')?'buying_catalog':
   anchor.closest('.home-fast-results')?'home_check':
   anchor.closest('.protocol-item')?'preparedness_plan':
   anchor.closest('.review-product-compact')?'review_product':
   anchor.closest('.ready-shop-card')?'offer_card':'other';
  window.gtag('event','affiliate_click',{
   offer_code:match[1],
   page_path:location.pathname,
   placement,
   transport_type:'beacon'
  });
 },{capture:true});
})();
</script>}
