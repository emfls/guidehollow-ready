---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPublishedReviews } from '../../lib/reviews';
import { resolvePartnerLink } from '../../lib/partner-code';
import ProductPhoto from '../../components/ProductPhoto.astro';
import PartnerOfferCard from '../../components/PartnerOfferCard.astro';
import { reviewShoppingOffers } from '../../data/buying-guide';
import { affiliateOffers } from '../../data/affiliate-product-visuals';
export async function getStaticPaths() {
 const rows=await getPublishedReviews();
 return rows.map(row=>({params:{slug:row.id},props:{row}}));
}
const {row}=Astro.props;
const {Content}=await render(row);
// Only show personally issued, exact-option product links. Other comparison models stay in archival source data.
const products=row.data.products.map(p=>({...p,partner:resolvePartnerLink(p)})).filter(p=>Boolean(p.partner));
const date=row.data.publishedDate.toISOString().slice(0,10);
const isSimpleE20=row.id==='fenix-e20-v2-flashlight';
const actualSaleOffer=row.id==='emergency-power-banks-10000-vs-20000'?'battery':row.id==='emergency-first-aid-kit-and-dressings'?'firstaid':undefined;
const saleComparison=actualSaleOffer==='battery'?{
 title:'현재 연결된 구매 상품: 삼성 EB-P3401XUKGKR (2026년형, 10,000mAh)',
 why:'정전 대비 휴대용 예비 전원으로 검토할 수 있는 2026년형 삼성 EB-P3401입니다. USB-C 2포트·최대 25W 등은 삼성 공식 사양 기준이며, 실제 구성·가격·배송은 판매 화면에서 확인하세요.',
 caution:'일부 이전 출시 제품의 시험 수치가 아니라 이 상품의 실제 옵션과 제조사 사양을 기준으로 선택하세요. KC·정품 유통·배송·케이블 동봉 여부는 판매 페이지에서 확인하세요.',
}:actualSaleOffer==='firstaid'?{
 title:'현재 연결된 구매 상품: 한양 스피드 구급함 대형 19종세트',
 why:'이미 구성품이 들어 있는 구급함을 찾는 가정이 확인할 수 있는 판매 상품입니다. 기본 비상물품을 한곳에 정리하는 용도입니다.',
 caution:'구성품 19종의 개별 규격·멸균 여부·사용기한은 판매 상세에서 확인하세요. 다른 드레싱 제품의 구성과 혼동하지 마세요.',
}:undefined;
const featured=isSimpleE20?products[0]:undefined;
const reviewOffers=reviewShoppingOffers[row.id]??[];
const additionalOffers=reviewOffers.filter(item=>item.offer!==actualSaleOffer &&
 !products.some(product=>product.partner?.url===affiliateOffers[item.offer].url));
const verifiedCoupangPhoto='https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/vendor_inventory/9c13/0524ccbea15e678332b3299a00596c66101a6e50f267850bb9970650169a.jpg';
---
<Base title={row.data.title} description={row.data.description}>
{isSimpleE20 && featured?.partner ? (
 <div class="container simple-product-page">
  <nav class="simple-product-crumb" aria-label="현재 위치"><a href="/starter-kit/">우리 집 준비물 점검</a><span aria-hidden="true">›</span><span>페닉스 E20 V2.0</span></nav>
  <p class="simple-product-disclosure">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
  <section class="simple-product-hero" aria-labelledby="simple-product-title">
   <div class="simple-product-media">
    <a href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="페닉스 E20 V2.0 상품 사진을 눌러 쿠팡에서 구매 정보 확인">
     <img src={verifiedCoupangPhoto} width="212" height="212" loading="eager" decoding="async" referrerpolicy="no-referrer" alt="쿠팡에 등록된 페닉스 E20 V2.0 손전등 제품 사진"/>
     <span class="simple-photo-tip">사진을 눌러 쿠팡에서 확인 ↗</span>
    </a>
    <p>쿠팡 판매 상품 사진 · 구성품은 판매처에서 확인</p>
   </div>
   <div class="simple-product-intro">
    <span class="simple-product-eyebrow">비상용 손전등 · 건전지 교체형</span>
    <h1 id="simple-product-title">정전됐을 때,<br/><em>건전지만 있으면 켜져요</em></h1>
    <p>페닉스 E20 V2.0은 충전 없이 <strong>AA 건전지 2개</strong>로 쓰는 손전등입니다. 휴대전화 배터리를 아껴야 하는 순간에 쓸 예비 조명으로 좋아요.</p>
    <div class="simple-product-points">
     <span>AA 건전지 2개</span><span>밝기 4단계</span><span>길이 약 12.7cm</span>
    </div>
    <a class="simple-buy-button" href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="페닉스 E20 V2.0 쿠팡에서 구매하기 (새 창)">구매하기 <span aria-hidden="true">↗</span></a>
    <small>제조사 자료 기반 검토 · 직접 사용한 후기가 아닙니다 · 가격·판매자·배송·옵션은 쿠팡에서 확인</small>
    <a href="#read-before-buy" class="simple-read-more">구매 전에 장점과 단점 읽기 ↓</a>
   </div>
  </section>
  <div class="simple-product-three" aria-label="제품 특징">
   <div><b>✓</b><strong>충전 기다릴 필요 없이</strong><span>건전지 교체해서 사용</span></div>
   <div><b>✓</b><strong>필요한 만큼 밝게</strong><span>상황에 맞춰 조절</span></div>
   <div><b>✓</b><strong>비상가방에 넣어 두기</strong><span>휴대하기 좋은 크기</span></div>
  </div>
  <article class="simple-product-story readable" id="read-before-buy"><Content/></article>
  {additionalOffers.length>0 && <section class="review-related-buying" aria-labelledby="review-related-title">
   <h2 id="review-related-title">함께 준비할 물품</h2>
   <p>손전등에 쓰는 규격을 확인한 뒤 필요하면 예비 건전지를 준비하세요. 구성과 가격은 쿠팡에서 다시 확인하세요.</p>
   <div class="review-related-buy-grid">
    {additionalOffers.map(item=><PartnerOfferCard offer={item.offer} title={affiliateOffers[item.offer].alt} note={item.why}/>)}
   </div>
  </section>}
  <section class="simple-product-bottom-buy">
   <div><h2>우리 집 손전등으로 괜찮겠다면</h2><p>현재 가격과 실제 건전지 구성, 배송 조건을 쿠팡에서 확인하세요.</p></div>
   <a class="simple-buy-button" href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="페닉스 E20 V2.0 쿠팡에서 구매하기 (새 창)">구매하기 ↗</a>
  </section>
  <details class="simple-product-sources">
   <summary>검증 근거·출처와 구매 전 주의사항 보기 <span aria-hidden="true">⌄</span></summary>
   <p>이 글은 직접 사용한 후기가 아니라 제조사 정보와 외부 사용 경험을 참고해 정리한 내용입니다. 제조사는 최대 밝기 350루멘, AA 건전지 2개, 방수·방진 등급 IP68을 표기하지만 작동 시간은 밝기 설정에 따라 달라집니다.</p>
   <p>쿠팡 판매 글과 제휴 링크의 상품번호·선택 옵션은 일치하는 것으로 확인했습니다. 다만 정품 유통 여부, 국내 인증 적용, 실제 배터리 동봉 수량과 사후 서비스는 판매 페이지에서 추가 확인하세요.</p>
   <ul><li><a href={featured.officialUrl} target="_blank" rel="noopener noreferrer">페닉스 제조사 공식 제품 안내 ↗</a></li>{featured.independentSources.map(u=><li><a href={u} target="_blank" rel="noopener noreferrer">외부 사용 평가 참고 ↗</a></li>)}</ul>
  </details>
  <div class="simple-product-related"><a href="/starter-kit/">물·식량·조명 한 번에 준비하기 →</a><a href="/checklist/">우리 집 준비물 체크 →</a></div>
 </div>
):(
<div class="container review-reading">
 <nav class="review-breadcrumb"><a href="/reviews/">제품·준비물 가이드</a><span aria-hidden="true">›</span><span>자세히 보기</span></nav>
 <header class="review-reading-head">
  <span class="review-chip">쿠팡 제휴 상품 연결 · 구매 전 참고</span>
  {(row.data.affiliate||actualSaleOffer||additionalOffers.length>0) && <p class="review-affiliate-top">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>}
  <h1>{row.data.title}</h1>
  <p>{row.data.description}</p>
  <span class="review-date">자료 검토 {date} · 이 글의 직접 연결 모델 {products.length}종 · 관련 판매 상품 {reviewOffers.length}종</span>
 </header>
 {row.data.keyTakeaways.length>0 && <section class="review-quick-read" aria-labelledby="quick-review-title">
  <h2 id="quick-review-title">먼저 이것만 확인하세요</h2>
  <ul>{row.data.keyTakeaways.slice(0,3).map(text=><li>{text}</li>)}</ul>
 </section>}
 {actualSaleOffer && saleComparison && <section class="review-matched-offer" aria-labelledby="review-matched-offer-title">
  <span class="review-matched-kicker">쿠팡파트너스 등록 · 구매할 상품</span>
  <h2 id="review-matched-offer-title">{saleComparison.title}</h2>
  <p>{saleComparison.why}</p>
  <PartnerOfferCard offer={actualSaleOffer} title={saleComparison.title} note={saleComparison.caution}/>
  <p class="review-matched-note">쿠팡에서 이 상품의 정확한 옵션·현재 가격·배송·반품 조건을 확인한 후 구매를 결정하세요.</p>
 </section>}
 {additionalOffers.length>0 && <section class="review-related-buying" aria-labelledby="review-related-title">
  <span class="review-matched-kicker">쿠팡파트너스 등록 상품 · 부족한 품목만 구매</span>
  <h2 id="review-related-title">선택 가능한 판매 상품</h2>
  <p>아래에는 게시자가 제공한 쿠팡파트너스 링크가 있는 상품만 표시합니다. 현재 가격·재고·배송은 변동될 수 있으므로 판매 화면에서 다시 확인하세요. 가족 상황과 보유 장비에 맞는 경우에만 선택하세요.</p>
  <div class="review-related-buy-grid">
   {additionalOffers.map(item=><PartnerOfferCard offer={item.offer} title={affiliateOffers[item.offer].alt} note={item.why}/>)}
  </div>
 </section>}
 {products.length>0 && <div class="review-product-grid" aria-label="제품별 쉬운 비교">
  {products.map((p,i)=><section class="review-product-compact">
   <div class="review-product-top"><span>제품 {i+1}</span><span>쿠팡 구매 링크 등록</span></div>
   {p.partner?.imageUrl && <div class="review-product-photo"><ProductPhoto src={p.partner.imageUrl} alt={p.name+' '+p.modelNumber+' 제품 사진'}/></div>}
   <h2>{p.name}</h2>
   <p class="review-model">{p.modelNumber}</p>
   <p class="review-product-for">{p.bestFor}</p>
   <div class="review-procon"><strong>좋은 점</strong><p>{p.strengths[0]}</p></div>
   <div class="review-procon review-procon--caution"><strong>아쉬운 점</strong><p>{p.limitations[0]}</p></div>
   {p.partner && <a class="btn primary review-cta" href={p.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={p.name+' 쿠팡에서 구매하기 (새 창)'}>구매하기 ↗</a>}
   <details class="review-card-details">
    <summary>다른 특징·주의사항 보기</summary>
    <h3>장점 더 보기</h3><ul>{p.strengths.slice(1).map(s=><li>{s}</li>)}</ul>
    <h3>주의할 점</h3><ul>{p.limitations.map(s=><li>{s}</li>)}</ul>
    <p><a href={p.officialUrl} target="_blank" rel="noopener noreferrer">제조사 사양 확인 ↗</a></p>
   </details>
  </section>)}
 </div>}
 <details class="review-source-expand">
  <summary>검증 근거와 상세 설명 펼쳐보기 <span aria-hidden="true">⌄</span></summary>
  <div class="review-source-content readable"><Content/>
   {products.map(p=><section><h3>{p.name} 확인 자료</h3><p>{p.verificationNotes}</p><p><a href={p.officialUrl} target="_blank" rel="noopener noreferrer">제조사 공식 제품 안내</a></p></section>)}
   <p><a href="/sources/">공식 재난 대응 정보·출처 확인</a>. 과거에 검토한 다른 판매 모델은 구매 추천 목록에 표시하지 않습니다.</p>
  </div>
 </details>
 <aside class="review-reading-next"><div><strong>무엇부터 준비해야 할지 모르겠다면?</strong><p>물·식량·전원·구급용품을 한 번에 점검하세요.</p></div><a href="/starter-kit/" class="btn primary">준비물 6가지 보기 →</a></aside>
</div>
)}
</Base>
