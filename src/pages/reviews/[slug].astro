---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPublishedReviews } from '../../lib/reviews';
import { resolvePartnerLink } from '../../lib/partner-code';
export async function getStaticPaths() {
 const rows=await getPublishedReviews();
 return rows.map(row=>({params:{slug:row.id},props:{row}}));
}
const {row}=Astro.props;
const {Content}=await render(row);
const products=row.data.products.map(p=>({...p,partner:resolvePartnerLink(p)}));
const date=row.data.publishedDate.toISOString().slice(0,10);
const isSimpleE20=row.id==='fenix-e20-v2-flashlight';
const featured=isSimpleE20?products[0]:undefined;
const verifiedCoupangPhoto='https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/vendor_inventory/9c13/0524ccbea15e678332b3299a00596c66101a6e50f267850bb9970650169a.jpg';
---
<Base title={row.data.title} description={row.data.description}>
{isSimpleE20 && featured?.partner ? (
 <div class="container simple-product-page">
  <nav class="simple-product-crumb" aria-label="현재 위치"><a href="/starter-kit/">비상 준비 장바구니</a><span aria-hidden="true">›</span><span>페닉스 E20 V2.0</span></nav>
  <p class="simple-product-disclosure">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
  <section class="simple-product-hero" aria-labelledby="simple-product-title">
   <div class="simple-product-media">
    <a href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="페닉스 E20 V2.0 상품 사진을 눌러 쿠팡에서 구매 정보 확인">
     <img src={verifiedCoupangPhoto} width="212" height="212" loading="eager" decoding="async" referrerpolicy="no-referrer" alt="쿠팡에 등록된 페닉스 E20 V2.0 손전등 제품 사진"/>
     <span class="simple-photo-tip">사진을 눌러 쿠팡에서 확인 ↗</span>
    </a>
    <p>쿠팡 판매 상품 사진 · 구성품은 판매처에서 확인</p>
   </div>
   <div class="simple-product-intro">
    <span class="simple-product-eyebrow">비상용 손전등 · 건전지 교체형</span>
    <h1 id="simple-product-title">정전됐을 때,<br/><em>건전지만 있으면 켜져요</em></h1>
    <p>페닉스 E20 V2.0은 충전 없이 <strong>AA 건전지 2개</strong>로 쓰는 손전등입니다. 휴대전화 배터리를 아껴야 하는 순간에 쓸 예비 조명으로 좋아요.</p>
    <div class="simple-product-points">
     <span>AA 건전지 2개</span><span>밝기 4단계</span><span>길이 약 12.7cm</span>
    </div>
    <a class="simple-buy-button" href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer">쿠팡에서 이 상품 확인하기 <span aria-hidden="true">↗</span></a>
    <small>가격·배송·판매자 확인은 쿠팡에서 · 제휴 링크</small>
    <a href="#read-before-buy" class="simple-read-more">구매 전에 장점과 단점 읽기 ↓</a>
   </div>
  </section>
  <div class="simple-product-three" aria-label="제품 특징">
   <div><b>✓</b><strong>충전 기다릴 필요 없이</strong><span>건전지 교체해서 사용</span></div>
   <div><b>✓</b><strong>필요한 만큼 밝게</strong><span>상황에 맞춰 조절</span></div>
   <div><b>✓</b><strong>비상가방에 넣어 두기</strong><span>휴대하기 좋은 크기</span></div>
  </div>
  <article class="simple-product-story readable" id="read-before-buy"><Content/></article>
  <section class="simple-product-bottom-buy">
   <div><h2>우리 집 손전등으로 괜찮겠다면</h2><p>현재 가격과 실제 건전지 구성, 배송 조건을 쿠팡에서 확인하세요.</p></div>
   <a class="simple-buy-button" href={featured.partner.url} target="_blank" rel="sponsored nofollow noopener noreferrer">쿠팡에서 제품 보러 가기 ↗</a>
  </section>
  <details class="simple-product-sources">
   <summary>제품 정보 확인 출처와 주의사항 보기 <span aria-hidden="true">⌄</span></summary>
   <p>이 글은 직접 사용한 후기가 아니라 제조사 정보와 외부 사용 경험을 참고해 정리한 내용입니다. 제조사는 최대 밝기 350루멘, AA 건전지 2개, 방수·방진 등급 IP68을 표기하지만 작동 시간은 밝기 설정에 따라 달라집니다.</p>
   <p>쿠팡 판매 글과 제휴 링크의 상품번호·선택 옵션은 일치하는 것으로 확인했습니다. 다만 정품 유통 여부, 국내 인증 적용, 실제 배터리 동봉 수량과 사후 서비스는 판매 페이지에서 추가 확인하세요.</p>
   <ul><li><a href={featured.officialUrl} target="_blank" rel="noopener noreferrer">페닉스 제조사 공식 제품 안내 ↗</a></li>{featured.independentSources.map(u=><li><a href={u} target="_blank" rel="noopener noreferrer">외부 사용 평가 참고 ↗</a></li>)}</ul>
  </details>
  <div class="simple-product-related"><a href="/starter-kit/">물·식량·조명 한 번에 준비하기 →</a><a href="/checklist/">우리 집 준비물 체크 →</a></div>
 </div>
):(
<div class="container narrow">
 <div class="page-intro"><a href="/" class="eyebrow">GuideHollow Ready 구매 가이드</a>
  {row.data.affiliate && <div class="ad-notice"><strong>광고·제휴 고지</strong> 이 글은 쿠팡파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받을 수 있습니다.</div>}
  <h1>{row.data.title}</h1><p>{row.data.description}</p>
  <p class="source-caption">발행 {date} {row.data.updatedDate ? `· 수정 ${row.data.updatedDate.toISOString().slice(0,10)}`:''} · 공식 출처 {row.data.sources.length}개 · {row.data.affiliate?'제휴 링크 포함':'제휴 링크 없음'}</p>
 </div>
 <article class="readable">
  {row.data.keyTakeaways.length>0&&<div class="takeaway"><span>핵심 먼저</span><h2>구매 전에 알아둘 내용</h2><ul>{row.data.keyTakeaways.map(t=><li>{t}</li>)}</ul></div>}
  <Content/>
  {products.map(p=><section class="verified-item">
    {p.partner?.imageUrl&&<img src={p.partner.imageUrl} alt={p.name} loading="lazy" decoding="async" referrerpolicy="no-referrer"/>}
    <span class="tag">검증 확인 · {p.label}</span>
    <h2>{p.name}</h2><p>모델: {p.modelNumber}</p>
    <h3>이런 상황에 적합해요</h3><p>{p.bestFor}</p>
    <h3>공식 자료로 확인한 장점</h3><ul>{p.strengths.map(t=><li>{t}</li>)}</ul>
    <h3>구매 전 알아야 할 단점</h3><ul>{p.limitations.map(t=><li>{t}</li>)}</ul>
    <h3>검증 근거</h3><p>{p.verificationNotes}</p>
    <p><a href={p.independentSources[0]} target="_blank" rel="noopener noreferrer">독립 평가 근거 ↗</a></p>
    <a class="btn secondary" href={p.officialUrl} target="_blank" rel="noopener noreferrer">제조사 공식 사양 ↗</a>
    {p.partner&&<a class="btn primary" href={p.partner.url} rel="sponsored nofollow noopener noreferrer" target="_blank">쿠팡에서 동일 모델 확인 · 제휴 ↗</a>}
    <p class="source-caption">검증일 {p.checkedAt.toISOString().slice(0,10)}. 실제 판매 조건·옵션은 구매 직전에 다시 확인하세요.</p>
   </section>)}
  <section class="references"><h2>자료·출처</h2><ul>{row.data.sources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>)}</ul></section>
  <p class="info-note">이 사이트는 실시간 경보 서비스가 아닙니다. 제품 사양은 변경될 수 있으므로 구매 전 판매처와 제조사 자료를 다시 확인하세요.</p>
 </article>
</div>
)}
</Base>
