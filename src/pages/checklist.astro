.check-stale strong{display:block}
.check-stale button{display:inline-block;min-height:44px;padding:8px 14px;margin:7px 0 0;border:1px solid #d9f0e4;background:#26454b;color:#f6fff9;border-radius:9px;font-size:.87rem;font-weight:750}
.check-stale button:focus-visible{outline:3px solid white;outline-offset:3px}
.check-backup{padding:19px 21px;margin:24px 0;border:1px solid #47605f;border-radius:13px;background:#1b3037;color:#d7e5e5}
