---
import Base from '../../layouts/Base.astro';
import {sources} from '../../data/resources';
import {protocolStages,protocolCategories,protocolItems} from '../../data/protocols';
import {affiliateOffers,affiliatePhoto} from '../../data/affiliate-product-visuals';
import ProductPhoto from '../../components/ProductPhoto.astro';
const initialDays=3;
---
<Base title="3일·7일·14일·30일·60일·90일 비상 대비 프로토콜" description="준비 기간을 선택하면 가족별 식수 참고량, 필요한 물품, 기존 체크리스트 현황과 실제 확인된 쿠팡 제휴 상품을 구분해서 보여줍니다.">
<div class="container protocol-page" id="protocol-root">
 <header class="protocol-hero">
  <span class="eyebrow">평상시 대비 · 기간별 계획</span>
  <h1>비상 준비, <em>3일부터 90일까지</em></h1>
  <p>집에 이미 있는 것부터 시작하세요. 기간을 고르면 <strong>그때까지 준비할 물품</strong>과 가족별 식수 계산, 확인된 상품을 볼 수 있습니다.</p>
  <div class="protocol-hero-actions"><a href="/starter-kit/">우리 집 준비 상태 확인 →</a><a href="/emergency/">실제 위험이라면 긴급 행동 →</a></div>
 </header>
 <section class="protocol-guidance" aria-labelledby="protocol-guidance-title">
  <h2 id="protocol-guidance-title">기간별 목록을 읽는 방법</h2>
  <p><strong>3일</strong>은 초기 준비 기준, <strong>7·14일</strong>은 보강 단계, <strong>30일</strong>은 국내 비상대비 물자 안내를 참고한 장기 계획입니다. <strong>60·90일</strong>은 정부 의무 기준이 아닌 자율적인 장기 대응 시나리오입니다. 각 기간의 준비 목록은 앞 단계의 물품을 포함합니다.</p>
  <p>물품 구매가 안전을 보장하지 않습니다. 공식 경보·대피 지시가 항상 우선이며, 특히 90일치 식수·식량을 전부 집에 사서 쌓아 두도록 권장하지 않습니다.</p>
 </section>
 <section class="protocol-stages-section" aria-labelledby="protocol-days-title">
  <div class="section-head"><span class="section-label">1단계 · 준비 기간 선택</span><h2 id="protocol-days-title">어느 기간을 준비할까요?</h2><p>목표 기간을 선택하세요. 물품 목록과 계산량이 함께 바뀝니다.</p></div>
  <div class="protocol-stage-picker" role="group" aria-label="준비 기간 선택">
   {protocolStages.map(stage=><button class="protocol-stage-btn" type="button" data-protocol-days={stage.days} aria-pressed={stage.days===initialDays} aria-controls="protocol-supply-list">
    <strong>{stage.name}</strong><small>{stage.subtitle}</small>
   </button>)}
  </div>
  <div class="protocol-selected" aria-live="polite" aria-atomic="true">
   <span id="protocol-phase-label">첫 72시간</span><h3 id="protocol-phase-title">3일 준비 프로토콜</h3>
   <p id="protocol-phase-lead">{protocolStages[0].lead}</p>
   <p class="protocol-phase-detail" id="protocol-phase-detail">{protocolStages[0].detail}</p>
  </div>
 </section>
 <section class="protocol-calculator" id="protocol-water" aria-labelledby="protocol-water-title">
  <div class="section-head"><span class="section-label">2단계 · 가족별 수량 참고</span><h2 id="protocol-water-title">식수는 얼마나 필요할까요?</h2><p>미국 CDC의 1인 하루 약 3.8L를 사용한 참고 계산입니다. 마시기·기본 위생에 쓰는 양이며 개인 건강·날씨에 따라 달라집니다.</p></div>
  <div class="protocol-calc-inputs">
   <label for="protocol-people">준비할 가족 인원 <span><input id="protocol-people" type="number" inputmode="numeric" min="1" max="20" step="1" value="1"/> 명</span></label>
   <label for="protocol-water-owned">집에 있는 안전한 비축수 <span><input id="protocol-water-owned" type="number" inputmode="decimal" min="0" max="10000" step="0.1" value="0"/> L</span></label>
  </div>
  <div class="protocol-result-grid" aria-live="polite" aria-atomic="true">
   <div><small id="protocol-water-total-label">3일 전체 참고량</small><strong id="protocol-water-total">11.4 L</strong></div>
   <div><small>이미 있는 물을 뺀 참고 부족분</small><strong id="protocol-water-gap">11.4 L</strong></div>
   <div id="protocol-water-cartons-card"><small>2L × 12병(24L) 묶음으로 환산</small><strong id="protocol-water-cartons">1묶음</strong></div>
  </div>
  <p class="protocol-water-warning" id="protocol-water-warning">미국 CDC는 최소 3일치, 가능하면 2주치 비상식수를 권고합니다. 이 수치는 구매 지시가 아니라 집에 있는 물을 확인하기 위한 참고값입니다.</p>
  <p class="protocol-water-caveat">30·60·90일의 계산량은 <strong>장기간 전체 사용량을 단순 환산한 시뮬레이션</strong>입니다. 같은 양을 생수로 전부 구매하거나 집에 보관해야 한다는 뜻이 아닙니다. 장기 공급·안전한 급수 경로를 별도로 계획하세요.</p>
 </section>
 <section class="protocol-supplies" id="protocol-supply-list" aria-labelledby="protocol-supplies-title">
  <div class="section-head"><span class="section-label">3단계 · 준비물 점검</span><h2 id="protocol-supplies-title">선택 기간 준비물 목록</h2><p>상품 링크는 사용자가 제공한 쿠팡파트너스 등록 상품에만 표시됩니다. 없는 품목에는 임의의 구매 링크를 만들지 않습니다.</p></div>
  <div class="protocol-filterbar">
   <div class="protocol-display-modes" role="group" aria-label="준비물 표시 범위">
    <button id="protocol-mode-all" type="button" aria-pressed="true">해당 기간까지 전체</button>
    <button id="protocol-mode-new" type="button" aria-pressed="false">이번 단계 추가분</button>
   </div>
   <p id="protocol-supply-status" role="status" aria-live="polite">3일 준비물 목록을 표시합니다.</p>
  </div>
  <div class="protocol-groups">
   {protocolCategories.map(category=><section class="protocol-group" data-protocol-category={category.id} aria-labelledby={'protocol-category-'+category.id}>
     <div class="protocol-group-heading"><span aria-hidden="true">{category.emoji}</span><h3 id={'protocol-category-'+category.id}>{category.title}</h3></div>
     <div class="protocol-item-grid">
      {protocolItems.filter(item=>item.category===category.id).map(item=><article class="protocol-item" data-protocol-item={item.id} data-protocol-from={item.from} data-check-id={item.checkId} hidden={item.from>initialDays}>
       <div class="protocol-item-content">
        <div class="protocol-item-title-row"><h4>{item.title}</h4>{item.optional && <span class="protocol-optional">선택 품목</span>}</div>
        <p>{item.note}</p>
        {item.checkId && <small class="protocol-check-status" data-protocol-check-status>기존 체크 기록 확인 중</small>}
        <div class="protocol-item-links"><a href={item.guide}>준비 기준 보기 →</a></div>
       </div>
       {item.offer && <div class="protocol-item-offer">
        <ProductPhoto src={affiliatePhoto(item.offer)} alt={affiliateOffers[item.offer].alt+' 제품 사진'} offer={item.offer} fallback={affiliateOffers[item.offer].emoji}/>
        <a href={affiliateOffers[item.offer].url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={affiliateOffers[item.offer].alt+' 쿠팡에서 구매하기 (새 창)'}>구매하기 ↗</a>
       </div>}
      </article>)}
     </div>
    </section>)}
  </div>
  <p class="protocol-affiliate-disclosure"><strong>쿠팡파트너스 제휴 고지</strong> — 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 가격·재고·옵션·배송은 쿠팡에서 확인해야 하며, 상품 구매가 해당 기간의 충분한 대비를 의미하지 않습니다.</p>
 </section>
 <section class="protocol-next" aria-labelledby="protocol-next-title">
  <h2 id="protocol-next-title">물건 다음으로 꼭 필요한 것</h2>
  <div><a href="/checklist/">기본 22항목 상세 체크리스트 →</a><a href="/plan/">가족 대피·연락 계획 →</a><a href="/starter-kit/">가족별 준비 현황 확인 →</a></div>
 </section>
 <section class="protocol-sources" aria-labelledby="protocol-sources-title">
  <h2 id="protocol-sources-title">공식 기준과 이 페이지의 한계</h2>
  <p>국민안전24는 비상대비 물자로 간편한 식량·식수 30일분 등을 안내하고, 호우 안내에서는 최소 3일간 사용할 물자를 준비하도록 권합니다. 미국 CDC는 하루 약 1갤런(약 3.8L)씩 최소 3일, 가능하면 2주치 비상식수를 안내합니다. 기간 7·14·60·90일 단계별 품목 구성은 이 사이트의 편집상 계획으로, 정부가 승인한 고정 물품·수량 목록이 아닙니다.</p>
  <ul>
   <li><a href={sources.supplies} target="_blank" rel="noopener noreferrer">국민안전24 — 비상대비 물자 준비요령 ↗</a></li>
   <li><a href={sources.waterGuide} target="_blank" rel="noopener noreferrer">미국 CDC — 비상식수 준비·보관 안내 ↗</a></li>
   <li><a href="https://www.safekorea.go.kr/safekorea-kor/acts/nacts/action-guide.do?actsHeaderTitle=%ED%98%B8%EC%9A%B0&category=heavyRain&menuSn=4" target="_blank" rel="noopener noreferrer">국민안전24 — 호우 대비 최소 3일 안내 ↗</a></li>
  </ul>
  <p>정보 확인: 2026년 10월 29일 · 이 페이지는 실시간 재난 경보가 아니며 실제 위험 시 정부와 현장 지시가 우선합니다.</p>
 </section>
 <noscript><p class="info-note">자바스크립트가 꺼져 있으면 첫 3일 준비 목록만 표시됩니다. 다른 기간의 목록은 스크립트를 켠 뒤 확인하세요.</p></noscript>
</div>
<script>
const stages=[...document.querySelectorAll<HTMLButtonElement>('[data-protocol-days]')];
const items=[...document.querySelectorAll<HTMLElement>('[data-protocol-item]')];
const categories=[...document.querySelectorAll<HTMLElement>('[data-protocol-category]')];
const allMode=document.querySelector<HTMLButtonElement>('#protocol-mode-all');
const newMode=document.querySelector<HTMLButtonElement>('#protocol-mode-new');
const people=document.querySelector<HTMLInputElement>('#protocol-people');
const owned=document.querySelector<HTMLInputElement>('#protocol-water-owned');
const phaseLabel=document.querySelector<HTMLElement>('#protocol-phase-label');
const phaseTitle=document.querySelector<HTMLElement>('#protocol-phase-title');
const phaseLead=document.querySelector<HTMLElement>('#protocol-phase-lead');
const phaseDetail=document.querySelector<HTMLElement>('#protocol-phase-detail');
const supplyStatus=document.querySelector<HTMLElement>('#protocol-supply-status');
const waterTotal=document.querySelector<HTMLElement>('#protocol-water-total');
const waterGap=document.querySelector<HTMLElement>('#protocol-water-gap');
const waterCartons=document.querySelector<HTMLElement>('#protocol-water-cartons');
const waterCard=document.querySelector<HTMLElement>('#protocol-water-cartons-card');
const waterNote=document.querySelector<HTMLElement>('#protocol-water-warning');
const waterTotalLabel=document.querySelector<HTMLElement>('#protocol-water-total-label');
const stageDetails=[
 {days:3,label:'첫 72시간',lead:'정전·단수·통신 장애가 시작되더라도 바로 쓸 물·음식·빛·정보와 안전한 대피 계획을 먼저 준비합니다.',detail:'국민안전24 호우 대비 안내와 미국 CDC의 최소 3일 비상식수 참고를 바탕으로 구성했습니다.'},
 {days:7,label:'초기 비축 확장',lead:'3일 준비를 유지한 채 위생·보온·예비 전원을 보강합니다.',detail:'7일은 이 사이트의 실용적 확장 단계입니다. 정부가 모든 가정에 별도로 명령한 기준은 아닙니다.'},
 {days:14,label:'2주 버티기',lead:'식수 보관 장소, 교체 일정, 식품 종류를 정리하고 가족별 필요를 다시 계산합니다.',detail:'미국 CDC는 가능하다면 2주치 식수를 준비하라고 안내합니다. 모든 가정에 동일한 양을 일괄 구매하라는 뜻은 아닙니다.'},
 {days:30,label:'국내 장기 대비 안내',lead:'국민안전24의 식량·식수 30일분 안내를 참고하되 실제 집에 맞는 저장 공간·교체 비용·취사 가능성을 점검합니다.',detail:'국민안전24 비상대비 물자 준비 안내의 식량·식수 30일분을 참고했습니다. 사용량은 개인별로 조정해야 합니다.'},
 {days:60,label:'장기 생활 유지 계획',lead:'한 번에 대량 구매하기보다 재보급·보관·위생·건강 관리가 중단되는 상황을 대비해 계획을 세웁니다.',detail:'60일은 정부 공식 의무 비축 기간이 아닌 자율적 장기 시나리오입니다.'},
 {days:90,label:'장기 회복·대체 계획',lead:'집에만 머무는 계획이 아니라 장기 정전·단수, 재보급 중단, 이동 필요성에 대한 여러 대안을 준비합니다.',detail:'90일은 정부 공식 의무 비축 기간이 아닌 자율적 장기 시나리오입니다. 90일치 생수를 일괄 구매하라는 권장이 아닙니다.'},
];
let chosenDays=3;
let onlyNew=false;
function checklistStatus(){
 try{
  const raw=localStorage.getItem('guidehollow-ready-check-v1');
  if(raw===null)return {valid:true,known:false,ids:new Set<string>()};
  const rows:unknown=JSON.parse(raw);
  if(!Array.isArray(rows)||!rows.every(v=>typeof v==='string')||new Set(rows).size!==rows.length)throw Error('bad record');
  return {valid:true,known:true,ids:new Set(rows as string[])};
 }catch{return {valid:false,known:false,ids:new Set<string>()};}
}
function renderProtocol(){
 const chosen=stageDetails.find(d=>d.days===chosenDays)||stageDetails[0];
 if(phaseLabel)phaseLabel.textContent=chosen.label;
 if(phaseTitle)phaseTitle.textContent=chosen.days+'일 준비 프로토콜';
 if(phaseLead)phaseLead.textContent=chosen.lead;
 if(phaseDetail)phaseDetail.textContent=chosen.detail;
 stages.forEach(btn=>btn.setAttribute('aria-pressed',String(Number(btn.dataset.protocolDays)===chosenDays)));
 allMode?.setAttribute('aria-pressed',String(!onlyNew));
 newMode?.setAttribute('aria-pressed',String(onlyNew));
 const saved=checklistStatus();
 let visible=0,offers=0;
 items.forEach(item=>{
  const from=Number(item.dataset.protocolFrom);
  const show=onlyNew?from===chosenDays:from<=chosenDays;
  item.hidden=!show;
  if(show){visible++;if(item.querySelector('.protocol-item-offer'))offers++;}
  const check=item.querySelector<HTMLElement>('[data-protocol-check-status]');
  if(check){
   const id=item.dataset.checkId||'';
   check.textContent=!saved.valid?'저장된 기록을 읽을 수 없습니다':!saved.known?'상세 체크 기록 없음':saved.ids.has(id)?'상세 항목 체크됨 · 상태 재확인':'상세 미체크 · 보유 여부 확인';
  }
 });
 categories.forEach(category=>{category.hidden=!category.querySelector('[data-protocol-item]:not([hidden])');});
 if(supplyStatus)supplyStatus.textContent=chosenDays+'일 기준 '+(onlyNew?'이번 단계 추가':'누적')+' 준비물 '+visible+'개 · 연결된 쿠팡 상품 '+offers+'종';
 updateWater();
}
function updateWater(){
 const inputPeople=Number(people?.value),inputOwned=Number(owned?.value);
 const persons=Number.isInteger(inputPeople)&&inputPeople>=1&&inputPeople<=20?inputPeople:1;
 const available=Number.isFinite(inputOwned)&&inputOwned>=0&&inputOwned<=10000?inputOwned:0;
 const theoretical=Math.round(chosenDays*3.8*persons*10)/10;
 const missing=Math.round(Math.max(0,theoretical-available)*10)/10;
 if(waterTotal)waterTotal.textContent=theoretical.toFixed(1)+' L';
 if(waterGap)waterGap.textContent=missing.toFixed(1)+' L';
 if(waterTotalLabel)waterTotalLabel.textContent=chosenDays+'일 이론적 참고 사용량';
 if(waterCartons)waterCartons.textContent=Math.ceil(missing/24)+'묶음';
 if(waterCard)waterCard.hidden=chosenDays>14;
 if(waterNote)waterNote.textContent=chosenDays<=14?'CDC 참고량으로 계산한 물의 필요량입니다. 24L 묶음은 단순 환산이며 반드시 해당 상품을 구매해야 한다는 뜻이 아닙니다.':'30일 이상은 사용량 추정치만 표시합니다. 현실적으로 안전한 장기 급수·재보급 계획을 세우세요. 모든 양을 생수로 구매하거나 집에 보관하라는 권장이 아닙니다.';
}
stages.forEach(button=>button.addEventListener('click',()=>{chosenDays=Number(button.dataset.protocolDays)||3;renderProtocol();}));
allMode?.addEventListener('click',()=>{onlyNew=false;renderProtocol();});
newMode?.addEventListener('click',()=>{onlyNew=true;renderProtocol();});
people?.addEventListener('input',updateWater);
owned?.addEventListener('input',updateWater);
window.addEventListener('pageshow',renderProtocol);
window.addEventListener('storage',event=>{if(event.key==='guidehollow-ready-check-v1'||event.key===null)renderProtocol();});
renderProtocol();
</script>
</Base>
