---
import { affiliateOffers, affiliatePhoto } from '../data/affiliate-product-visuals';
import ProductPhoto from './ProductPhoto.astro';
const checks=[
 {id:'water',icon:'💧',question:'마실 물과 기본 위생용 물이 있나요?',offer:'water',checkId:'water-bottles',fit:'생수가 부족하거나 보관 상태를 다시 확인해야 하는 가정',skip:'식수량이 이미 충분하고 안전하게 보관된 경우',name:'아이시스 무라벨 생수 2L × 12개',reason:'3일간 마실 물과 기본 위생용 물을 인원에 맞춰 계산하세요',caveat:'24L 묶음이 가족의 전체 필요량과 일치한다는 뜻은 아닙니다',guide:'/buying/food/'},
 {id:'food',icon:'🥫',question:'전기가 없어도 바로 먹을 식품이 있나요?',offer:'tuna',checkId:'shelf-food',fit:'조리 없이 먹을 수 있는 식품 종류가 부족한 가정',skip:'동일한 통조림이 충분하거나 생선 알레르기가 있는 경우',name:'동원 라이트 스탠다드 참치 100g × 10개',reason:'조리 없이 먹는 상온 식품을 서로 다른 종류로 준비하세요',caveat:'참치 한 종류로 영양을 충족할 수 없고 알레르기·소비기한 확인이 필요합니다',guide:'/buying/food/'},
 {id:'light',icon:'🔦',question:'건전지형 손전등이 정상 작동하나요?',offer:'flashlight',checkId:'lamp',fit:'현관이나 침실에 별도 손전등이 없는 가정',skip:'손전등이 이미 충분하거나 양손 사용이 중요한 경우',name:'페닉스 E20 V2.0 손전등',reason:'휴대전화 배터리를 아끼면서 정전 시 주변을 밝힐 수 있어요',caveat:'AA 건전지 2개의 준비 및 동봉 여부와 작동 상태를 확인하세요',guide:'/reviews/fenix-e20-v2-flashlight/'},
 {id:'radio',icon:'📻',question:'인터넷 없이 소식을 들을 라디오가 있나요?',offer:'radio',checkId:'radio',fit:'인터넷 없이 방송 수신할 라디오가 없는 가정',skip:'기존 라디오가 정상 작동하고 수신이 잘 되는 경우',name:'소니 ICF-P26 블랙 라디오',reason:'휴대전화·데이터 통신에 문제가 생기더라도 방송을 들을 수 있어요',caveat:'AA 건전지 2개와 지역 AM/FM 수신 가능 여부를 먼저 확인하세요',guide:'/reviews/emergency-am-fm-radios/'},
 {id:'power',icon:'🔋',question:'충전된 보조배터리와 케이블이 있나요?',offer:'battery',checkId:'powerbank',fit:'충전된 보조배터리가 없어 통신기기 예비 전원이 필요한 가정',skip:'이미 충전·점검한 보조배터리가 충분한 경우',name:'삼성 EB-P3401 베이지 10,000mAh',reason:'정전 중 휴대전화의 연락·경보 확인 시간을 늘리는 예비 전원입니다',caveat:'케이블·휴대전화 호환성, 남은 충전량과 이상 발열을 점검하세요',guide:'/reviews/emergency-power-banks-10000-vs-20000/'},
] as const;
---
<section class="home-fast-check" id="home-fast-check" aria-labelledby="home-fast-check-title">
 <div class="home-fast-check-head">
  <div>
   <span class="section-label">평상시 대비 · 72시간</span>
   <h2 id="home-fast-check-title">3일 대비, 우리 집은 얼마나 준비됐을까요?</h2>
   <p>5가지만 빠르게 확인하세요. <strong>확인이 필요한 품목만</strong> 아래에 연결합니다. 답변은 서버로 보내지 않습니다. 직접 저장을 누르면 이 브라우저에 남기고, 보유 확인 항목만 상세 체크리스트에 반영합니다.</p>
  </div>
  <a class="home-fast-protocol-link" href="/protocols/">3일~90일 준비 계획 →</a>
 </div>
 <div class="home-fast-questions" role="group" aria-label="우리 집 3일 대비 빠른 점검">
  {checks.map((item,i)=><fieldset class="home-fast-question" data-home-fast-question={item.id} data-home-checklist-id={item.checkId}>
   <legend><span aria-hidden="true">{item.icon}</span><span class="home-fast-number">{String(i+1).padStart(2,'0')}</span>{item.question}</legend>
   <div class="home-fast-options">
    <label><input type="radio" name={'home-check-'+item.id} value="have"/><span>갖고 있어요</span></label>
    <label><input type="radio" name={'home-check-'+item.id} value="need"/><span>확인 필요</span></label>
   </div>
  </fieldset>)}
 </div>
 <div class="home-fast-progress"><span id="home-fast-count">0 / 5항목 선택</span><button type="button" id="home-fast-reset">다시 점검</button></div>
 <div class="home-fast-results" id="home-fast-results" hidden aria-live="polite">
  <div class="home-fast-results-head"><h3 id="home-fast-results-title">확인할 상품</h3><p id="home-fast-results-status" role="status">답변을 선택하면 해당 품목이 표시됩니다.</p></div>
  <div class="home-fast-result-grid">
   {checks.map(item=><article class="home-fast-result-card" data-home-fast-product={item.id} hidden>
    <div class="home-fast-result-photo"><ProductPhoto src={affiliatePhoto(item.offer)} alt={affiliateOffers[item.offer].alt+' 제품 사진'} offer={item.offer} fallback={item.icon}/></div>
    <div class="home-fast-result-copy">
      <span class="home-fast-match-label">확인 필요 · 대체 구매 예시</span>
      <h4>{item.name}</h4>
      <p>{item.reason}</p>
      <p class="home-fast-fit"><strong>추천 대상</strong> {item.fit}</p>
      <p class="home-fast-fit"><strong>구매 보류</strong> {item.skip}</p>
      <small>구매 전 확인: {item.caveat}</small>
      <div class="home-fast-result-actions"><a href={item.guide} class="home-fast-learn">선택 기준 →</a><a href={affiliateOffers[item.offer].url} class="home-fast-buy" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={item.name+' 쿠팡에서 구매하기 (새 창)'}>구매하기 ↗</a></div>
    </div>
   </article>)}
  </div>
  <section class="home-fast-water-plan" aria-labelledby="home-fast-water-plan-title">
   <h4 id="home-fast-water-plan-title">가족 수로 먼저 식수 필요량 계산</h4>
   <p>해외 CDC의 1인 하루 약 3.8L 참고값을 이용한 3일 계획입니다. 실제 사용량은 건강 상태·기온·생활용수에 따라 달라집니다.</p>
   <div class="home-fast-water-inputs">
    <label for="home-fast-people">함께 준비하는 인원 <input id="home-fast-people" type="number" min="1" max="20" step="1" value="2" inputmode="numeric"/></label>
    <label for="home-fast-water-owned">이미 있는 생수 (L) <input id="home-fast-water-owned" type="number" min="0" max="10000" step="0.5" value="0" inputmode="decimal"/></label>
   </div>
   <p class="home-fast-water-answer" role="status"><span id="home-fast-water-total">—</span> 필요 참고량 · <strong id="home-fast-water-gap">—</strong> 추가 확인 · 2L×12개 묶음 <strong id="home-fast-water-packs">—</strong>개 분량</p>
   <small>24L 생수 묶음은 계산 단위 예시이지 특정 수량 구매 권유가 아닙니다. 현재 가격·배송·보관 공간을 확인하세요.</small>
  </section>
  <div class="home-fast-save-actions">
   <button type="button" id="home-fast-save">진단 결과를 이 브라우저에 저장</button>
   <a href="/buying/?from=quick" id="home-fast-shop-continue" hidden>확인 필요한 상품 이어서 보기 →</a>
   <p id="home-fast-save-status" role="status">직접 저장해야 다음 방문에서도 진단 결과가 유지됩니다. '갖고 있어요'만 상세 체크리스트에 추가하며 기존 체크 항목은 지우지 않습니다.</p>
  </div>
  <p id="home-fast-all-ready" class="home-fast-all-ready" hidden>모두 '갖고 있어요'로 선택했습니다. 수량·작동 상태·소비기한과 가족별 필요량을 확인해야 실제 준비 상태를 판단할 수 있습니다.</p>
  <p class="home-fast-disclosure"><strong>제휴 안내</strong> — 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 링크는 등록 당시 모델을 확인한 상품 예시이며 직접 사용한 검증 후기는 아닙니다. 구매 전에 옵션·가격·재고·배송을 확인하세요. <strong>상품을 샀다고 재난 대비가 완료되는 것은 아닙니다.</strong></p>
 </div>
 <div class="home-fast-check-foot"><span>미체크·‘확인 필요’는 미보유 확정이 아닙니다</span><a href="/checklist/">22항목 상세 체크리스트에 기록하기 →</a></div>
</section>
<script>
const fields=[...document.querySelectorAll<HTMLFieldSetElement>('[data-home-fast-question]')];
const results=document.querySelector<HTMLElement>('#home-fast-results');
const cards=[...document.querySelectorAll<HTMLElement>('[data-home-fast-product]')];
const count=document.querySelector<HTMLElement>('#home-fast-count');
const status=document.querySelector<HTMLElement>('#home-fast-results-status');
const allReady=document.querySelector<HTMLElement>('#home-fast-all-ready');
const reset=document.querySelector<HTMLButtonElement>('#home-fast-reset');
const save=document.querySelector<HTMLButtonElement>('#home-fast-save');
const savedStatus=document.querySelector<HTMLElement>('#home-fast-save-status');
const shopContinue=document.querySelector<HTMLAnchorElement>('#home-fast-shop-continue');
const people=document.querySelector<HTMLInputElement>('#home-fast-people');
const owned=document.querySelector<HTMLInputElement>('#home-fast-water-owned');
const waterTotal=document.querySelector<HTMLElement>('#home-fast-water-total');
const waterGap=document.querySelector<HTMLElement>('#home-fast-water-gap');
const waterPacks=document.querySelector<HTMLElement>('#home-fast-water-packs');
const quickKey='guidehollow-ready-quick-check-v1';
const detailKey='guidehollow-ready-check-v1';
let savedPlan=false;
function waterPlan(){
 const persons=Number(people?.value),available=Number(owned?.value);
 if(!Number.isInteger(persons)||persons<1||persons>20||!Number.isFinite(available)||available<0||available>10000){
  if(waterTotal)waterTotal.textContent='인원·물 수량 확인';
  if(waterGap)waterGap.textContent='—';
  if(waterPacks)waterPacks.textContent='—';
  return;
 }
 const required=persons*3*3.8;
 const short=Math.max(0,required-available);
 if(waterTotal)waterTotal.textContent=required.toFixed(1)+'L';
 if(waterGap)waterGap.textContent=short.toFixed(1)+'L';
 if(waterPacks)waterPacks.textContent=String(Math.ceil(short/24));
}

function updateQuickCheck(){
 let answered=0,needs=0;
 for(const field of fields){
  const radio=field.querySelector<HTMLInputElement>('input[type="radio"]:checked');
  if(radio)answered++;
  if(radio?.value==='need')needs++;
  field.dataset.answered=radio?.value||'';
 }
 for(const card of cards){
  const field=fields.find(f=>f.dataset.homeFastQuestion===card.dataset.homeFastProduct);
  card.hidden=field?.dataset.answered!=='need';
 }
 if(count)count.textContent=answered+' / '+fields.length+'항목 선택';
 if(results)results.hidden=answered===0;
 if(status)status.textContent=needs>0?'추가 확인할 품목 '+needs+'가지 · 집에 있는 물품과 비교한 후 필요한 경우에만 구매하세요':answered===fields.length?'선택한 항목은 모두 보유 중입니다 · 실제 수량·상태를 점검하세요':'현재 선택한 항목에는 구매 안내가 없습니다 · 다른 항목도 확인해 보세요';
 if(allReady)allReady.hidden=needs!==0||answered!==fields.length;
 if(shopContinue)shopContinue.hidden=!savedPlan||needs===0;
 waterPlan();
}
function restoreSavedQuickCheck(){
 try{
  const raw=localStorage.getItem(quickKey);
  if(!raw)return;
  const parsed:unknown=JSON.parse(raw);
  if(typeof parsed!=='object'||parsed===null||Array.isArray(parsed))return;
  const values=parsed as Record<string,unknown>;
  if(Object.keys(values).some(key=>!fields.some(f=>f.dataset.homeFastQuestion===key)))return;
  for(const field of fields){
   const answer=values[field.dataset.homeFastQuestion||''];
   if(answer!=='have'&&answer!=='need')continue;
   const radio=field.querySelector<HTMLInputElement>('input[value="'+answer+'"]');
   if(radio)radio.checked=true;
  }
  savedPlan=true;
  if(savedStatus)savedStatus.textContent='이 브라우저에 저장한 빠른 진단 결과를 불러왔습니다. 상세 수량과 작동 상태는 다시 확인하세요.';
 }catch{
  if(savedStatus)savedStatus.textContent='저장된 진단 결과를 읽을 수 없습니다. 기존 체크리스트는 변경하지 않았습니다.';
 }
}
fields.forEach(f=>f.addEventListener('change',()=>{
 savedPlan=false;
 if(savedStatus)savedStatus.textContent='답변이 바뀌었습니다. 변경된 결과를 유지하려면 다시 저장하세요.';
 updateQuickCheck();
}));
people?.addEventListener('input',waterPlan);
owned?.addEventListener('input',waterPlan);
save?.addEventListener('click',()=>{
 try{
  const previous=localStorage.getItem(detailKey);
  const stored:unknown=previous===null?[]:JSON.parse(previous);
  if(!Array.isArray(stored)||!stored.every(id=>typeof id==='string')||new Set(stored).size!==stored.length)
   throw Error('Invalid checklist data');
  const answers:Record<string,'have'|'need'>={};
  const confirmed:string[]=[];
  for(const field of fields){
   const answer=field.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value;
   const id=field.dataset.homeFastQuestion,checkId=field.dataset.homeChecklistId;
   if(id&&(answer==='have'||answer==='need')){
    answers[id]=answer;
    if(answer==='have'&&checkId)confirmed.push(checkId);
   }
  }
  if(Object.keys(answers).length===0){
   if(savedStatus)savedStatus.textContent='먼저 한 가지 이상을 점검해 주세요.';
   return;
  }
  const union=[...new Set([...(stored as string[]),...confirmed])];
  // Persist only in response to the explicit save action; never auto-complete unanswered checks.
  localStorage.setItem(quickKey,JSON.stringify(answers));
  localStorage.setItem(detailKey,JSON.stringify(union));
  savedPlan=true;
  if(savedStatus)savedStatus.textContent='이 브라우저에 결과를 저장했습니다. 보유 선택 '+confirmed.length+'개만 기존 22항목 체크리스트에 추가했고, 다른 체크 기록은 보존했습니다.';
  updateQuickCheck();
 }catch{
  if(savedStatus)savedStatus.textContent='저장하지 못했습니다. 기존 상세 체크 기록은 덮어쓰지 않았습니다. 브라우저 저장 공간을 확인해 주세요.';
 }
});
reset?.addEventListener('click',()=>{
 for(const r of document.querySelectorAll<HTMLInputElement>('.home-fast-question input[type="radio"]'))r.checked=false;
 savedPlan=false;
 try{localStorage.removeItem(quickKey);}catch{}
 if(savedStatus)savedStatus.textContent='빠른 진단 선택을 초기화했습니다. 별도 상세 체크리스트는 변경하지 않았습니다.';
 updateQuickCheck();
});
restoreSavedQuickCheck();
updateQuickCheck();
</script>
