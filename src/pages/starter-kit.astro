---
import Base from '../layouts/Base.astro';
import { sources } from '../data/resources';
const verifiedFlashlightUrl='https://link.coupang.com/a/idtdhvDZ3A';
const verifiedFlashlightImage='https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/vendor_inventory/9c13/0524ccbea15e678332b3299a00596c66101a6e50f267850bb9970650169a.jpg';
const groups=[
 {id:'water',number:'01',icon:'💧',title:'마실 물',tag:'가장 먼저',description:'가족이 3일 동안 마시고 기본적으로 사용할 물을 준비하세요.',need:'해외 CDC 참고: 1명 하루 약 3.8L × 3일. 가족에 맞게 조절하세요.',guide:'/buying/food/',guideText:'물 준비 방법'},
 {id:'food',number:'02',icon:'🥫',title:'바로 먹는 음식',tag:'식량',description:'전기가 끊겨도 데우지 않고 먹을 수 있는 식품을 3일치 챙기세요.',need:'익히지 않아도 먹는 음식. 알레르기·소비기한 확인.',guide:'/buying/food/',guideText:'비상식량 고르기'},
 {id:'light',number:'03',icon:'🔦',title:'손전등 + 건전지',tag:'구매 상품 검증',description:'밤에 정전돼도 휴대전화 배터리를 쓰지 않고 주변을 밝힐 수 있어요.',need:'손전등과 여분 건전지. 기존 제품은 작동 여부부터 확인.',guide:'/reviews/fenix-e20-v2-flashlight/',guideText:'손전등 상세 보기',verified:true},
 {id:'power',number:'04',icon:'🔋',title:'전원·정보 수단',tag:'정전 대비',description:'휴대전화를 충전하고, 인터넷이 안 될 때도 소식을 들을 방법이 필요해요.',need:'충전된 보조배터리·케이블·비상 라디오.',guide:'/buying/gear/',guideText:'전원·라디오 선택법'},
 {id:'medical',number:'05',icon:'🩹',title:'구급·위생용품',tag:'가족별 조절',description:'상처를 돌보고, 물이 부족할 때도 기본 위생을 지킬 수 있도록 준비하세요.',need:'기본 구급함·개인 복용약·휴지·위생용품.',guide:'/checklist/#kit-medical',guideText:'구급·위생 체크'},
 {id:'carry',number:'06',icon:'🎒',title:'가방·옷·연락처',tag:'대피 준비',description:'급하게 이동해야 할 때 중요한 물건을 찾느라 시간을 쓰지 않도록 하세요.',need:'걷기 좋은 신발·여벌옷·가방·종이 연락처.',guide:'/plan/',guideText:'가족 대피 계획'},
] as const;
---
<Base title="우리 집 비상 준비물 점검: 필요한 것만 준비하세요" description="가족 수에 따른 식수 참고량을 계산하고 기본 준비물 6가지 중 추가 확인할 품목과 구매 전 주의점을 한 화면에서 확인하세요.">
<div class="container starter-hub">
 <header class="starter-hub-hero">
  <div class="starter-hub-copy"><span class="eyebrow">우리 집 비상 준비</span><h1>우리 집 비상용품,<br/><em>이 6가지부터 준비하세요</em></h1>
   <p>가족 수에 맞는 식수량을 계산하고, <strong>이미 갖춘 물품은 체크</strong>하세요. 남은 항목은 아래 한눈에 모아 보여드립니다.</p>
   <a href="#starter-personal" class="btn primary">우리 집 준비 상태 확인하기 ↓</a>
  </div>
  <aside class="starter-progress" aria-label="준비 현황">
    <span>우리 집 준비 현황</span><strong><span id="starter-ready-count">0</span><small> / 6가지</small></strong>
    <p id="starter-ready-status" aria-live="polite">집에 있는 물건부터 표시해 보세요</p>
    <progress id="starter-ready-progress" max="6" value="0" aria-label="6가지 기본 준비물 점검 현황">0/6</progress>
    <small>체크 결과는 이 브라우저에만 저장됩니다</small>
  </aside>
 </header>
 <div class="starter-notice"><strong>물건을 샀다고 대비가 모두 끝나는 것은 아닙니다.</strong><span>대피시설과 가족 연락 방법까지 확인해야 합니다. 구매 전 집에 있는 물건을 먼저 활용하세요.</span></div>
<section class="starter-personal" id="starter-personal" aria-labelledby="starter-personal-title">
  <div class="starter-personal-head">
   <div><span class="section-label">평상시 준비 · 가족별 참고량</span><h2 id="starter-personal-title">우리 집에는 얼마나 필요할까요?</h2><p>가족 수와 보유한 물을 입력하면 <strong>72시간 식수 참고량과 부족한 양</strong>을 보여드립니다.</p></div>
   <a href="/emergency/" class="starter-emergency-link">지금 위험하다면 긴급 행동 보기 →</a>
  </div>
  <div class="starter-water-calc">
   <label for="starter-people">가족 인원 <input id="starter-people" type="number" inputmode="numeric" min="1" max="20" step="1" value="1" aria-describedby="starter-water-source"/> 명</label>
   <label for="starter-water-owned">이미 비축한 안전한 물 <input id="starter-water-owned" type="number" inputmode="decimal" min="0" max="10000" step="0.1" value="0" aria-describedby="starter-water-source"/> L</label>
   <div class="starter-water-result" aria-live="polite" aria-atomic="true">
    <div><small>3일간 참고량</small><strong id="starter-water-needed">11.4 L</strong></div>
    <div><small>추가 확인할 양</small><strong id="starter-water-gap">11.4 L</strong></div>
   </div>
  </div>
  <p class="starter-water-note" id="starter-water-source">미국 CDC 참고량(1명 하루 약 3.8L × 3일)으로 음용과 기본 위생을 고려한 출발점입니다. 국내 전시 장기 비축 권고와 별도이며, 영유아·수유·질병·더위 등 상황에 따라 더 필요할 수 있습니다. <a href="/buying/food/">식수·보관 안내 보기 →</a> 입력한 인원과 물의 양은 서버에 전송하거나 저장하지 않습니다.</p>
  <div class="starter-missing-head">
   <div><h3>추가 확인할 품목 <span id="starter-missing-count" aria-live="polite">6</span>가지</h3><p>아직 체크하지 않은 품목을 모았습니다. <strong>미체크는 미보유 확정이 아닙니다.</strong> 집에 있는 수량과 작동 상태부터 확인하세요.</p></div>
   <div class="starter-missing-actions"><button type="button" id="starter-show-unchecked" class="starter-tool-btn" aria-pressed="false">확인 필요만 보기</button><button type="button" id="starter-copy-missing" class="starter-tool-btn">목록 복사</button></div>
  </div>
  <ul class="starter-missing-list" id="starter-missing-list" aria-label="아직 확인하지 않은 준비물">
   {groups.map(g=><li data-missing-for={g.id}><span><b>{g.icon} {g.title}</b><small>{g.need}</small></span><div class="starter-missing-row-actions"><a href={g.guide}>{g.guideText} →</a>{g.id==='light' && <a class="starter-missing-buy" href={verifiedFlashlightUrl} rel="sponsored nofollow noopener noreferrer" target="_blank">등록된 쿠팡 모델 확인 ↗</a>}</div></li>)}
  </ul>
  <div id="starter-missing-empty" class="starter-missing-empty" hidden>기본 6개 분야를 모두 확인했습니다. 실제 보유 수량·품질·소비기한과 가족 연락 계획도 점검하세요.</div>
  <div id="starter-copy-fallback-wrap" class="starter-copy-fallback" hidden><label for="starter-copy-fallback">복사를 허용하지 않는 브라우저입니다. 아래 내용을 직접 선택해 복사하세요.</label><textarea id="starter-copy-fallback" readonly rows="8"></textarea></div>
  <p class="starter-missing-note"><a href="/checklist/">기본 22개 항목과 영유아·어르신·반려동물 추가 준비 확인 →</a> · 해당하는 물품만 구매하세요. 쿠팡파트너스 제휴 링크는 손전등 1종에만 연결돼 있으며 구매 시 일정액의 수수료를 제공받습니다. 현재 가격·재고·판매자·배송은 쿠팡에서 확인하세요.</p>
 </section>
 <section id="starter-cards" class="starter-list-section" aria-labelledby="starter-list-title">
  <div class="starter-list-heading"><div><span class="section-label">기본 6가지</span><h2 id="starter-list-title">먼저 챙길 기본 6가지</h2><p>체크는 '충분한 양과 작동 상태까지 확인했다'는 뜻으로 사용하세요.</p></div><button id="starter-reset" class="starter-reset" type="button">체크 초기화</button></div>
  <div class="starter-set-grid">
   {groups.map(g=><article class="starter-set-card">
     <div class="starter-set-card-top"><span class="starter-set-index">{g.number}</span><span class="starter-set-emoji" aria-hidden="true">{g.icon}</span><span class="starter-set-tag">{g.tag}</span></div>
     <h3>{g.title}</h3><p class="starter-set-desc">{g.description}</p>

     <p class="starter-set-need"><strong>이 정도를 준비하세요</strong>{g.need}</p>
     <div class="starter-set-actions">
      <a href={g.guide} class="starter-guide-link">{g.guideText} →</a>
     </div>
     <label class="starter-owned"><input class="starter-owned-checkbox" type="checkbox" data-starter-id={g.id}/><span>우리 집에 충분히 준비돼 있어요</span></label>
    </article>)}
  </div>
  <section class="kit-featured-product" aria-labelledby="kit-product-title">
   <a class="kit-featured-image" href="/reviews/fenix-e20-v2-flashlight/"><img src={verifiedFlashlightImage} width="212" height="212" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="페닉스 E20 V2.0 손전등 상품 사진"/></a>
   <div><span class="review-chip">제조사 사양·쿠팡 등록 모델 확인</span><h3 id="kit-product-title">손전등이 없다면 · 페닉스 E20 V2.0</h3><p>휴대전화 배터리를 연락과 재난정보에 남겨두고 싶을 때 쓰는 별도 조명입니다. 충전 대신 AA 건전지 2개를 사용합니다.</p><ul class="kit-product-facts"><li><strong>좋은 점</strong> 건전지를 교체해 사용할 수 있고 밝기를 조절할 수 있습니다.</li><li><strong>구매 전</strong> AA 건전지 포함 여부·판매 옵션·가격·배송·A/S를 쿠팡에서 확인하세요. 양손을 써야 한다면 헤드랜턴도 비교하세요.</li></ul>
   <div class="kit-featured-actions"><a href={verifiedFlashlightUrl} rel="sponsored nofollow noopener noreferrer" target="_blank" class="starter-buy-now">쿠팡에서 상품 확인하기 ↗</a><a class="starter-guide-link" href="/reviews/fenix-e20-v2-flashlight/">장점·단점 읽기 →</a></div></div>
  </section>
  <p class="starter-affiliate-notice">손전등 구매 버튼은 쿠팡파트너스 제휴 링크입니다. 제조사 정보와 판매 등록 모델을 참고했으며 직접 사용한 후기가 아닙니다. 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 다른 품목에는 아직 검증되지 않은 상품 광고를 붙이지 않았습니다.</p>
 </section>
 <section class="starter-special" aria-labelledby="starter-special-title">
  <div><span class="section-label">가족에 맞춰 더 준비</span><h2 id="starter-special-title">우리 가족에게 필요한 건 더 챙기세요</h2><p>아기·어르신·반려동물이 함께라면 기본 세트만으로는 부족할 수 있습니다.</p></div>
  <div class="starter-special-links"><a href="/checklist/#kit-baby">🍼 영유아 기저귀·수유용품 →</a><a href="/checklist/#kit-care">💊 복용약·돌봄 용품 →</a><a href="/checklist/#kit-pet">🐾 반려동물 사료·이동장 →</a></div>
 </section>
 <section class="starter-final-steps" aria-labelledby="starter-final-title">
  <h2 id="starter-final-title">물건을 챙긴 다음 꼭 할 일</h2>
  <div><a href="/plan/"><b>01</b><span><strong>가족 연락·만날 장소 정하기</strong><small>전화가 안 될 때 누구에게, 어디로 갈지</small></span><span aria-hidden="true">→</span></a>
   <a href="/situations/"><b>02</b><span><strong>상황별 대피 방법 확인하기</strong><small>공습·화재·침수·지진에 따라 다릅니다</small></span><span aria-hidden="true">→</span></a>
   <a href="/checklist/"><b>03</b><span><strong>자세한 22개 기본 체크리스트 점검</strong><small>수량·유효기간·예비품까지 빠짐없이</small></span><span aria-hidden="true">→</span></a>
  </div>
 </section>
 <footer class="starter-source"><p>기본 준비 항목은 <a href={sources.supplies} target="_blank" rel="noopener noreferrer">국민안전24 비상대비 물자</a>와 <a href={sources.readyKit} target="_blank" rel="noopener noreferrer">미국 Ready.gov 비상용품 안내</a>를 참고했습니다. 하루 물 3.8L는 <a href={sources.waterGuide} target="_blank" rel="noopener noreferrer">미국 CDC의 참고 권장량</a>으로, 국내 의무 기준은 아닙니다. 실제 수량은 가족 구성과 건강 상태에 맞게 늘려야 합니다.</p></footer>
 <noscript><p class="info-note">자바스크립트를 끄면 체크 현황의 저장과 진행률은 작동하지 않습니다. 목록을 종이로 기록해도 됩니다.</p></noscript>
</div>
<script>
const starterCheckboxes=[...document.querySelectorAll<HTMLInputElement>('.starter-owned-checkbox')];
const starterKey='guidehollow-ready-starter-set-v1';
const counter=document.querySelector<HTMLElement>('#starter-ready-count');
const progress=document.querySelector<HTMLProgressElement>('#starter-ready-progress');
const status=document.querySelector<HTMLElement>('#starter-ready-status');
const missingRows=[...document.querySelectorAll<HTMLElement>('[data-missing-for]')];
const missingCount=document.querySelector<HTMLElement>('#starter-missing-count');
const missingEmpty=document.querySelector<HTMLElement>('#starter-missing-empty');
const missingFilter=document.querySelector<HTMLButtonElement>('#starter-show-unchecked');
const peopleInput=document.querySelector<HTMLInputElement>('#starter-people');
const waterOwnedInput=document.querySelector<HTMLInputElement>('#starter-water-owned');
function updateWater(){
 const validPeople=Number(peopleInput?.value);
 const validOwned=Number(waterOwnedInput?.value);
 const people=Number.isInteger(validPeople)&&validPeople>=1&&validPeople<=20?validPeople:1;
 const owned=Number.isFinite(validOwned)&&validOwned>=0&&validOwned<=10000?validOwned:0;
 const needed=Math.round(people*3*3.8*10)/10;
 const gap=Math.round(Math.max(0,needed-owned)*10)/10;
 const neededEl=document.querySelector<HTMLElement>('#starter-water-needed');
 const gapEl=document.querySelector<HTMLElement>('#starter-water-gap');
 if(neededEl)neededEl.textContent=needed.toFixed(1)+' L';
 if(gapEl)gapEl.textContent=gap.toFixed(1)+' L';
}
peopleInput?.addEventListener('input',updateWater);
waterOwnedInput?.addEventListener('input',updateWater);
updateWater();
function starterUpdate(){
 const n=starterCheckboxes.filter(x=>x.checked).length;
 if(counter)counter.textContent=String(n);
 if(progress)progress.value=n;
 if(status)status.textContent=n===6?'기본 6개 분야 점검 완료 · 대피·연락 계획도 확인하세요':n===0?'집에 있는 물건부터 표시해 보세요':n+'개 확인 · 부족한 품목을 이어서 준비하세요';
 const missingIds=new Set(starterCheckboxes.filter(x=>!x.checked).map(x=>x.dataset.starterId));
 missingRows.forEach(row=>{row.hidden=!missingIds.has(row.dataset.missingFor)});
 if(missingCount)missingCount.textContent=String(missingIds.size);
 if(missingEmpty)missingEmpty.hidden=missingIds.size!==0;
 const filtered=missingFilter?.getAttribute('aria-pressed')==='true';
 starterCheckboxes.forEach(x=>{const card=x.closest<HTMLElement>('.starter-set-card');if(card)card.hidden=filtered&&x.checked;});
}
try{
 const old=JSON.parse(localStorage.getItem(starterKey)||'[]');
 if(Array.isArray(old))starterCheckboxes.forEach(x=>x.checked=old.includes(x.dataset.starterId));
}catch{}
starterUpdate();
starterCheckboxes.forEach(x=>x.addEventListener('change',()=>{
 try{localStorage.setItem(starterKey,JSON.stringify(starterCheckboxes.filter(c=>c.checked).map(c=>c.dataset.starterId)))}catch{}
 starterUpdate();
}));
document.querySelector('#starter-reset')?.addEventListener('click',()=>{
 starterCheckboxes.forEach(x=>x.checked=false);
 try{localStorage.removeItem(starterKey)}catch{}
 starterUpdate();
});
missingFilter?.addEventListener('click',()=>{
 missingFilter.setAttribute('aria-pressed',String(missingFilter.getAttribute('aria-pressed')!=='true'));
 missingFilter.textContent=missingFilter.getAttribute('aria-pressed')==='true'?'6가지 모두 보기':'확인 필요만 보기';
 starterUpdate();
});
const copyButton=document.querySelector<HTMLButtonElement>('#starter-copy-missing');
copyButton?.addEventListener('click',async()=>{
 const lines=missingRows.filter(row=>!row.hidden).map(row=>'- '+(row.querySelector('b')?.textContent?.trim()??'')+' · '+(row.querySelector('small')?.textContent?.trim()??''));
 const text=['우리 집 추가 확인할 비상 준비물 (체크하지 않은 항목)',...lines,'실제 보유량과 품질 확인 후 부족한 것만 준비하세요.'].join('\\n');
 try{
  if(!navigator.clipboard?.writeText)throw Error('clipboard unavailable');
  await navigator.clipboard.writeText(text);
  copyButton.textContent='목록 복사됨';
 }catch{
  const wrap=document.querySelector<HTMLElement>('#starter-copy-fallback-wrap');
  const fallback=document.querySelector<HTMLTextAreaElement>('#starter-copy-fallback');
  if(wrap&&fallback){fallback.value=text;wrap.hidden=false;fallback.focus();fallback.select();}
 }
});

</script>
</Base>