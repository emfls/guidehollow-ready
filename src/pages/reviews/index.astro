---
import Base from '../../layouts/Base.astro';
import { getPublishedReviews } from '../../lib/reviews';
import { affiliatePhoto,affiliateOffers } from '../../data/affiliate-product-visuals';
import { reviewShoppingOffers } from '../../data/buying-guide';
import ProductPhoto from '../../components/ProductPhoto.astro';
const reviews = await getPublishedReviews();
const date=(d:Date)=>d.toISOString().slice(0,10);
const featured=reviews.filter(r=>r.data.affiliate);
const other=reviews.filter(r=>!r.data.affiliate);
const directOfferFor=(id:string)=>id==='fenix-e20-v2-flashlight'?'flashlight':id==='emergency-am-fm-radios'?'radio':undefined;
const shortTitles:Record<string,string>={
 'emergency-flashlights-headlamps':'손전등·헤드랜턴 비교',
 'emergency-am-fm-radios':'비상 라디오 고르는 법',
 'emergency-bags-dry-pouches':'방수 가방·파우치 비교',
 'emergency-blankets-and-hygiene-wipes':'비상담요·위생티슈 비교',
 'emergency-first-aid-kit-and-dressings':'가정용 구급함 준비',
 'emergency-kit-set-composition-audit':'비상용품 완성 세트 확인',
 'emergency-power-banks-10000-vs-20000':'보조배터리 2종 비교',
 'emergency-products-kc-model-expiry-audit':'안전 인증·사용기한 확인',
 'emergency-retail-option-priority-and-affiliate-gates':'구매 전 모델 확인 요령',
 'coupang-stock-audit-samsung-p3400-p3401':'삼성 보조배터리 구매 점검'
};
---
<Base title="검증 제품 비교·구매 가이드" description="공식 사양과 독립 평가로 검토한 재난 대비 제품의 모델번호, 장점, 단점, 제휴 링크 확인 상태를 공개합니다.">

 <div class="container review-hub-refresh">
  <header class="page-intro">
   <span class="eyebrow">제품 선택 가이드</span>
   <h1>필요한 제품,<br/>쉽게 비교하고 고르세요</h1>
   <p>필요한 상황·장단점을 먼저 확인하세요. <strong>이미 연결된 쿠팡 상품 30종</strong>에서 각 비교 주제에 맞는 제품을 안내합니다. 본문에서 비교한 모델과 실제 판매 상품이 다르면 별도로 구분하고, 현재 가격·재고·배송은 쿠팡에서 확인하세요.</p>
   <p class="review-affiliate-top">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
  </header>
  <a class="review-bundle-link" href="/starter-kit/#starter-personal"><div><strong>우리 집 확인 필요 물품 모아보기</strong><p>가족 수에 맞게 물을 계산하고 이미 있는 것은 제외하세요</p></div><span aria-hidden="true">→</span></a>
  {featured.length>0 && <section class="review-featured" aria-labelledby="review-featured-title">
   <div class="section-head"><span class="section-label">검증된 구매 링크</span><h2 id="review-featured-title">바로 상품 확인하기</h2></div>
   <div class="review-featured-grid">{featured.map(r=><article class="review-featured-card">
    <div class="review-featured-image">{r.id==='fenix-e20-v2-flashlight' && <ProductPhoto src={affiliatePhoto('flashlight')} offer="flashlight" alt="페닉스 E20 V2.0 손전등 상품 사진" fallback="🔦"/>}{r.id==='emergency-am-fm-radios' && <ProductPhoto src={affiliatePhoto('radio')} offer="radio" alt="소니 ICF-P26 블랙 라디오 상품 사진" fallback="📻"/>}</div>
    <div><span class="review-chip">판매 옵션과 비교 모델 일치</span><h3>{r.data.title}</h3><p>{r.data.description}</p><div class="review-hub-buy-actions">
     <a href={'/reviews/'+r.id+'/'} class="btn primary">장점·단점과 구매 정보 →</a>
     {directOfferFor(r.id) && <a class="review-direct-buy" href={affiliateOffers[directOfferFor(r.id)!].url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={affiliateOffers[directOfferFor(r.id)!].alt+' 쿠팡에서 구매하기 (새 창)'}>쿠팡에서 현재 가격 확인 ↗</a>}
    </div></div>
   </article>)}</div>
  </section>}
  <section class="review-directory" aria-labelledby="review-directory-title">
   <div class="section-head"><span class="section-label">주제별 연결 상품</span><h2 id="review-directory-title">비교 내용과 실제 판매 상품 함께 보기</h2><p>관련된 실제 쿠팡 상품을 각 글에서 바로 확인할 수 있습니다. <strong>비교 대상과 다른 모델은 동일 성능을 보증하지 않습니다.</strong></p></div>
   <div class="review-directory-grid">
    {other.map(r=><article class="review-directory-card">
      <span class="review-directory-label">{r.data.category==='power'?'전원·충전':r.data.category==='medical'?'구급·위생':r.data.category==='food'?'식량·식수':'준비용품'}</span>
      <h3>{shortTitles[r.id] ?? r.data.title}</h3>
      <p>{r.data.keyTakeaways[0] ?? r.data.description}</p>
      <a class="review-directory-link" href={'/reviews/'+r.id+'/'}>비교·주의사항 보기 →</a>
      {reviewShoppingOffers[r.id]?.[0] && <div class="review-directory-shop">
       <div class="review-directory-shop-image"><ProductPhoto src={affiliatePhoto(reviewShoppingOffers[r.id][0].offer)} offer={reviewShoppingOffers[r.id][0].offer} alt={affiliateOffers[reviewShoppingOffers[r.id][0].offer].alt+' 제품 사진'} fallback={affiliateOffers[reviewShoppingOffers[r.id][0].offer].emoji}/></div>
       <div class="review-directory-shop-content">
        <small>현재 등록된 관련 상품 · {reviewShoppingOffers[r.id].length}종 안내</small>
        <strong>{affiliateOffers[reviewShoppingOffers[r.id][0].offer].alt}</strong>
        <a href={affiliateOffers[reviewShoppingOffers[r.id][0].offer].url} class="review-direct-buy" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={affiliateOffers[reviewShoppingOffers[r.id][0].offer].alt+' 쿠팡에서 구매하기 (새 창)'}>쿠팡에서 상품 확인 ↗</a>
       </div>
      </div>}
    </article>)}
   </div>
  </section>
  <div class="review-hub-footer"><p>제품을 실제로 사용해 시험한 후기는 아닙니다. 제조사와 독립 자료를 확인한 구매 참고 정보입니다.</p><a href="/buying/">30가지 구매 가이드 →</a> <a href="/buying/gear/">용품 선택 기준 →</a></div>
 </div>
</Base>
