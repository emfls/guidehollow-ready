.missing-toggle{display:inline-flex;align-items:center;gap:9px;min-height:44px;padding:10px 12px;border:1px solid #66817f;background:#23403e;border-radius:10px;color:#e7f5ef;cursor:pointer;font-size:.87rem;font-weight:750}
.missing-toggle input{accent-color:#efb974;width:20px;height:20px;flex:none}
.missing-toggle:focus-within{outline:3px solid #ffd58f;outline-offset:2px}
