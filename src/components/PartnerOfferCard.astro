---
import { affiliateOffers, affiliatePhoto, type AffiliateOfferKey } from '../data/affiliate-product-visuals';
import ProductPhoto from './ProductPhoto.astro';
interface Props {
 offer:AffiliateOfferKey;
 title:string;
 note:string;
 buttonText?:string;
 checkId?:string;
}
const {offer,title,note,buttonText='구매하기 ↗',checkId}=Astro.props;
const item=affiliateOffers[offer];
const image=affiliatePhoto(offer);
---
<article class="ready-shop-card" data-affiliate-offer={offer} data-offer-check-id={checkId}>
 <div class="ready-shop-image"><ProductPhoto src={image} alt={item.alt+' 제품 사진'} offer={offer} fallback={item.emoji}/></div>
 <div class="ready-shop-body">
  <span class="ready-shop-chip">쿠팡파트너스 등록 상품</span>
  <h3>{title}</h3>
  {checkId && <small class="ready-shop-checkstatus" data-offer-check-status>상세 체크 기록 확인 중</small>}
  <p>{note}</p>
 </div>
 <div class="ready-shop-footer"><a href={item.url} class="partner-check-action" target="_blank" rel="sponsored nofollow noopener noreferrer">{buttonText}</a></div>
</article>
