---
import Base from '../../layouts/Base.astro';
import ProductPhoto from '../../components/ProductPhoto.astro';
import { affiliateOffers, affiliatePhoto } from '../../data/affiliate-product-visuals';
import { buyingGuideProducts, guideGroups } from '../../data/buying-guide';
const linked=buyingGuideProducts.filter(item=>item.offer);
---
<Base title="재난 대비 구매 가이드: 30가지 준비물과 검증된 쿠팡 상품" description="3일~90일 대비를 위한 30개 구매 후보의 선택 기준과 주의점, 보유 체크를 정리합니다. 쿠팡파트너스 링크는 실제 제공된 상품에만 연결합니다.">
<div class="container shop-guide-page">
 <header class="shop-guide-hero">
  <span class="eyebrow">평상시 대비 · 구매 가이드</span>
  <h1>필요한 것만 골라보는 <em>30가지 대비용품</em></h1>
  <p>어떤 상품을 사야 하는지보다 <strong>집에 어떤 준비물이 부족한지</strong> 먼저 확인하세요. 필요한 기간과 종류를 선택하면 비교 기준과 구매 가능한 상품을 한곳에서 볼 수 있습니다.</p>
  <div class="shop-guide-hero-stats" aria-label="구매 가이드 구성">
   <span><strong>{buyingGuideProducts.length}</strong>개 준비물 후보</span>
   <span><strong>{linked.length}</strong>개 등록된 쿠팡 제휴 상품</span>
   <span><strong>{guideGroups.length}</strong>개 분류</span>
  </div>
  <div class="shop-guide-hero-links"><a href="/starter-kit/#starter-personal">우리 집 먼저 점검하기 →</a><a href="/protocols/">3~90일 대비 프로토콜 →</a></div>
 </header>
 <aside class="shop-guide-facts" aria-labelledby="shop-guide-facts-title">
  <h2 id="shop-guide-facts-title">구매하기 전에 꼭 확인하세요</h2>
  <p>이 페이지의 30개는 <strong>실제 판매 제품 30종이 아니라 구매 검토용 품목 30개</strong>입니다. 제휴 링크가 등록된 것은 {linked.length}개뿐이며, 나머지는 모델·옵션·제휴 링크 확인 전까지 구매 버튼을 표시하지 않습니다. 구입했다고 대비가 끝나는 것은 아니며, 위험 상황에는 <a href="/emergency/">긴급 행동 안내</a>와 공식 지시가 우선입니다.</p>
 </aside>
 <section class="shop-guide-controls" aria-labelledby="shop-guide-filter-title">
  <div class="section-head"><span class="section-label">품목 찾기</span><h2 id="shop-guide-filter-title">우리 집에 필요한 물품 고르기</h2></div>
  <div class="shop-guide-filter-grid">
   <label for="shop-guide-duration">대비 기간
    <select id="shop-guide-duration">
     <option value="3" selected>3일 · 초기 준비</option>
     <option value="7">7일 · 1주일</option>
     <option value="14">14일 · 2주일</option>
     <option value="30">30일 · 1개월</option>
     <option value="60">60일 · 장기 대안 계획</option>
     <option value="90">90일 · 장기 대안 계획</option>
    </select>
   </label>
   <label for="shop-guide-category">품목 종류
    <select id="shop-guide-category">
     <option value="all" selected>전체 분야</option>
     {guideGroups.map(group=><option value={group.id}>{group.title}</option>)}
    </select>
   </label>
   <label for="shop-guide-link-filter">구매 가능 상태
    <select id="shop-guide-link-filter">
     <option value="all" selected>등록 상품 + 후보 전체</option>
     <option value="linked">등록된 쿠팡 상품만</option>
     <option value="pending">링크 검증 대기 품목만</option>
    </select>
   </label>
  </div>
  <div class="shop-guide-filter-bottom">
   <button type="button" id="shop-guide-unchecked" aria-pressed="false" disabled>상세 체크 미완료 항목만</button>
   <button type="button" id="shop-guide-clear">조건 초기화</button>
   <p id="shop-guide-results-count" role="status" aria-live="polite">준비물 목록을 정리하고 있습니다.</p>
  </div>
  <p id="shop-guide-check-note" class="shop-guide-check-note">상세 체크리스트의 저장 기록이 있으면 관련 항목의 확인 상태를 표시합니다. 미체크는 미보유 확정이 아닙니다.</p>
  <p id="shop-guide-period-note" class="shop-guide-period-note">3일은 재난 대비의 시작 단계입니다. 선택한 기간까지 필요한 품목을 누적 표시합니다.</p>
 </section>
 <section id="shop-guide-list" class="shop-guide-list" aria-labelledby="shop-guide-list-title">
  <h2 id="shop-guide-list-title">준비물과 구매 선택 기준</h2>
  {guideGroups.map(group=><section class="shop-guide-group" data-buy-group={group.id} aria-labelledby={'shop-group-'+group.id}>
   <div class="shop-guide-group-heading"><span aria-hidden="true">{group.icon}</span><div><h3 id={'shop-group-'+group.id}>{group.title}</h3><p>{group.description}</p></div></div>
   <div class="shop-guide-product-grid">
    {buyingGuideProducts.filter(item=>item.group===group.id).map(item=><article class="shop-guide-item" data-buy-id={item.id} data-buy-days={item.days} data-buy-category={item.group} data-buy-linked={item.offer?'yes':'no'} data-buy-check-id={item.checkId||undefined} hidden={item.days>3}>
     <div class="shop-guide-item-main">
      <div class="shop-guide-item-top"><span class:list={['shop-guide-state',item.offer?'is-linked':'is-pending']}>{item.offer?'쿠팡 연결됨':'상품 검증 대기'}</span><span class="shop-guide-days">{item.days}일부터</span><span class="shop-guide-priority">{item.priority}</span></div>
      <h4>{item.title}</h4>
      <p class="shop-guide-item-why">{item.why}</p>
      <dl>
       <div><dt>고르는 기준</dt><dd>{item.criteria}</dd></div>
       <div><dt>주의할 점</dt><dd>{item.caution}</dd></div>
      </dl>
      {item.checkId && <small class="shop-guide-check-state" data-check-state>상세 체크 기록 확인 중</small>}
      <a class="shop-guide-criteria-link" href={item.guide}>선택 기준 자세히 보기 →</a>
     </div>
     {item.offer ? <div class="shop-guide-product-option">
       <div class="shop-guide-photo"><ProductPhoto src={affiliatePhoto(item.offer)} offer={item.offer} alt={affiliateOffers[item.offer].alt+' 제품 사진'} fallback={affiliateOffers[item.offer].emoji}/></div>
       <p class="shop-guide-photo-label">{affiliateOffers[item.offer].alt}</p>
       <a href={affiliateOffers[item.offer].url} class="shop-guide-buy" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={affiliateOffers[item.offer].alt+' 쿠팡에서 구매하기 (새 창)'}>구매하기 ↗</a>
      </div> : <div class="shop-guide-unverified"><span aria-hidden="true">⌕</span><strong>구매 링크 준비 중</strong><small>정확한 판매 상품·옵션 및 제휴 링크 확인 전에는 구매 버튼을 표시하지 않습니다.</small></div>}
    </article>)}
   </div>
  </section>)}
  <p class="shop-guide-no-match" id="shop-guide-no-match" hidden>조건에 해당하는 물품이 없습니다. 기간이나 분야, 상품 연결 상태를 바꿔 확인하세요.</p>
 </section>
 <section class="shop-guide-next" aria-labelledby="shop-guide-next-title">
  <h2 id="shop-guide-next-title">30일 이후에는 구매 목록보다 유지 계획이 중요합니다</h2>
  <p>60일·90일은 공적 의무 비축 기간이 아닙니다. 30일 목록을 무조건 두 배·세 배로 사기보다, <strong>식수 재공급·식품 순환 소비·가족 연락·대피 및 보건 서비스 이용 계획</strong>을 준비하세요.</p>
  <div><a href="/protocols/">3~90일 계획 확인 →</a><a href="/checklist/">22항목 보유 현황 확인 →</a><a href="/buying/food/">식량·식수 안내 →</a><a href="/buying/gear/">장비 선택법 →</a></div>
 </section>
 <p class="shop-guide-disclosure"><strong>제휴 고지</strong> — 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 등록된 제휴 링크는 사용자가 제공한 개별 상품 URL이며 가격·재고·판매 옵션과 실제 품질은 구입 전 쿠팡에서 확인하세요. 이 사이트는 상품을 직접 사용해 시험한 후기가 아닙니다.</p>
</div>
<script>
const stage=document.querySelector<HTMLSelectElement>('#shop-guide-duration');
const category=document.querySelector<HTMLSelectElement>('#shop-guide-category');
const linkFilter=document.querySelector<HTMLSelectElement>('#shop-guide-link-filter');
const unchecked=document.querySelector<HTMLButtonElement>('#shop-guide-unchecked');
const clear=document.querySelector<HTMLButtonElement>('#shop-guide-clear');
const status=document.querySelector<HTMLElement>('#shop-guide-results-count');
const note=document.querySelector<HTMLElement>('#shop-guide-check-note');
const period=document.querySelector<HTMLElement>('#shop-guide-period-note');
const noMatch=document.querySelector<HTMLElement>('#shop-guide-no-match');
const cards=[...document.querySelectorAll<HTMLElement>('[data-buy-id]')];
const groups=[...document.querySelectorAll<HTMLElement>('[data-buy-group]')];
let uncheckedOnly=false;
function getExistingChecks(){
 try{
  const raw=localStorage.getItem('guidehollow-ready-check-v1');
  if(raw===null)return {known:false,valid:true,ids:new Set<string>()};
  const val:unknown=JSON.parse(raw);
  if(!Array.isArray(val)||!val.every(x=>typeof x==='string')||new Set(val).size!==val.length)throw Error('invalid');
  return {known:true,valid:true,ids:new Set(val as string[])};
 }catch{return {known:false,valid:false,ids:new Set<string>()};}
}
function updateGuide(){
 const days=Number(stage?.value)||3,selectedGroup=category?.value||'all',filter=linkFilter?.value||'all';
 const checked=getExistingChecks();
 if(unchecked){unchecked.disabled=!checked.known||!checked.valid;if(unchecked.disabled)uncheckedOnly=false;unchecked.setAttribute('aria-pressed',String(uncheckedOnly));unchecked.textContent=uncheckedOnly?'전체 보유 상태 보기':'상세 체크 미완료 항목만';}
 let shown=0,live=0,pending=0;
 for(const card of cards){
  const code=card.dataset.buyCheckId||'',linked=card.dataset.buyLinked==='yes',hasCheck=!!code;
  const isChecked=hasCheck&&checked.ids.has(code);
  const checkLabel=card.querySelector<HTMLElement>('[data-check-state]');
  if(checkLabel)checkLabel.textContent=!checked.valid?'체크 기록 확인 불가':!checked.known?'저장된 상세 체크 기록 없음':isChecked?'관련 상세 항목 체크됨 · 품목 수량은 별도 확인':'관련 상세 항목 미체크 · 보유 여부 확인 필요';
  const show=Number(card.dataset.buyDays)<=days&&(selectedGroup==='all'||selectedGroup===card.dataset.buyCategory)&&(filter==='all'||(filter==='linked')===linked)&&(!uncheckedOnly||(hasCheck&&!isChecked));
  card.hidden=!show;
  if(show){shown++;if(linked)live++;else pending++;}
 }
 for(const group of groups)group.hidden=!group.querySelector('.shop-guide-item:not([hidden])');
 if(status)status.textContent=shown+'개 품목 표시 · 등록된 쿠팡 상품 '+live+'개 · 링크 검증 대기 '+pending+'개';
 if(noMatch)noMatch.hidden=shown!==0;
 if(note)note.textContent=!checked.valid?'상세 체크 기록을 읽을 수 없어 미체크 필터를 끕니다. 기존 기록은 변경하지 않았습니다.':!checked.known?'상세 체크 기록이 없습니다. /checklist/에서 기본 22항목을 점검하면 관련 항목 확인 상태를 볼 수 있습니다.':'미체크는 미보유 확정이 아닙니다. 여러 품목이 같은 상세 항목과 연결될 수 있으므로 집에 있는 수량·상태부터 확인하세요.';
 if(period)period.textContent=days>=60?days+'일은 자율적 장기 계획입니다. 구매용 목록은 최대 30일 대비 범위로 표시하며, 더 많이 사라는 뜻이 아닙니다.':days+'일 단계까지 누적된 추천 검토 품목을 표시합니다. 보유품을 확인하고 필요한 제품만 선택하세요.';
}
stage?.addEventListener('change',updateGuide);
category?.addEventListener('change',updateGuide);
linkFilter?.addEventListener('change',updateGuide);
unchecked?.addEventListener('click',()=>{if(unchecked.disabled)return;uncheckedOnly=!uncheckedOnly;updateGuide();});
clear?.addEventListener('click',()=>{if(stage)stage.value='3';if(category)category.value='all';if(linkFilter)linkFilter.value='all';uncheckedOnly=false;updateGuide();});
window.addEventListener('pageshow',updateGuide);
window.addEventListener('storage',event=>{if(event.key==='guidehollow-ready-check-v1'||event.key===null)updateGuide();});
updateGuide();
</script>
</Base>
